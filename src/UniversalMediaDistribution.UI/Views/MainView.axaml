<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UniversalMediaDistribution.UI.ViewModels"
             xmlns:views="using:UniversalMediaDistribution.UI.Views"
             x:Class="UniversalMediaDistribution.UI.Views.MainView"
             x:DataType="vm:MainViewModel"
             d:DesignWidth="1180"
             d:DesignHeight="760"
             Background="{StaticResource BackdropBrush}"
             mc:Ignorable="d">
  <UserControl.Resources>
    <DataTemplate x:Key="ErrorFeedbackTemplate" x:DataType="vm:FeedbackViewModel">
      <Border Classes="notice danger" IsVisible="{Binding HasMessage}">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                   AutomationProperties.Name="{DynamicResource ErrorMessageLabel}"
                   Foreground="{StaticResource DangerTextBrush}" />
      </Border>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="CatalogWrapPanel">
      <WrapPanel />
    </ItemsPanelTemplate>

    <!-- The fallback for a chapter with too many pages to give each one a
         container. It brings back the estimated extent, and with it the drift,
         but a book of several hundred pages cannot afford the alternative. -->
    <ItemsPanelTemplate x:Key="ReaderVirtualizedPagePanel">
      <VirtualizingStackPanel CacheLength="1" />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="TelevisionCatalogGridPanel">
      <UniformGrid Columns="3" />
    </ItemsPanelTemplate>

    <!-- A shelf is one horizontal run of posters, the way every streaming app
         presents a row. Virtualized because a shelf can hold a whole genre,
         and a remote travelling right must not realize a hundred cards. -->
    <ItemsPanelTemplate x:Key="CatalogRowPanel">
      <VirtualizingStackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!-- One poster card, shared by the flat catalog grid and the home
         shelves so both stay identical. -->
    <DataTemplate x:Key="CatalogCardTemplate"
                  x:DataType="vm:CatalogCardViewModel">
      <Button Classes="catalog-card-button"
              AutomationProperties.AutomationId="{Binding Id, StringFormat='catalog-{0}'}"
              Command="{Binding OpenCommand}"
              AutomationProperties.Name="{Binding Name}"
              ToolTip.Tip="{Binding Name}">
        <Border Classes="catalog-card">
          <Grid>
            <Border Background="{StaticResource SurfaceRaisedBrush}"
                    IsVisible="{Binding !HasArtwork}">
              <TextBlock Text="{Binding TypeBadge}"
                         Foreground="{StaticResource TextFaintBrush}"
                         FontSize="62"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>

            <Border IsVisible="{Binding HasArtwork}"
                    IsHitTestVisible="False"
                    Opacity="0.92">
              <views:CatalogArtworkView
                  DataContext="{Binding Artwork}" />
            </Border>

            <Border IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="50%,0%"
                                     EndPoint="50%,100%">
                  <GradientStop Color="#A6131722" Offset="0" />
                  <GradientStop Color="#3D131722" Offset="0.38" />
                  <GradientStop Color="#F5131722" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <Grid Classes="card-content"
                  RowDefinitions="Auto,*,Auto"
                  IsHitTestVisible="False">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Background="{StaticResource BadgeScrimBrush}"
                        CornerRadius="999"
                        Padding="11,6">
                  <StackPanel Orientation="Horizontal"
                              Spacing="7">
                    <TextBlock Text="{Binding TypeBadge}"
                               Foreground="{StaticResource AccentTextBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Subtype}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeMicro}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Classes="chip mint"
                        Grid.Column="2"
                        Padding="10,5"
                        VerticalAlignment="Top">
                  <TextBlock Text="{Binding OriginBadge}"
                             Foreground="{StaticResource MintTextBrush}"
                             FontSize="{StaticResource FontSizeMicro}"
                             FontWeight="Bold"
                             MaxWidth="110"
                             TextTrimming="CharacterEllipsis" />
                </Border>
              </Grid>

              <StackPanel Classes="card-text"
                          Grid.Row="2"
                          VerticalAlignment="Bottom">
                <!-- Only for a title the viewer has started and that has since
                     gained something past where they stopped, so the shelf
                     answers "is there anything for me" without opening it. -->
                <Border Classes="chip"
                        HorizontalAlignment="Left"
                        Padding="9,4"
                        Margin="0,0,0,5"
                        IsVisible="{Binding HasNewContent}">
                  <TextBlock Text="{Binding NewContentText}"
                             Foreground="{StaticResource AccentTextBrush}"
                             FontSize="{StaticResource FontSizeMicro}"
                             FontWeight="Bold"
                             MaxWidth="200"
                             TextTrimming="CharacterEllipsis" />
                </Border>
                <TextBlock Classes="card-title"
                           Text="{Binding Name}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="19"
                           FontWeight="Bold"
                           LineHeight="24"
                           MaxLines="2"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="card-description"
                           Text="{Binding Description}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeCaption}"
                           MaxLines="2"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="card-taxonomy"
                           Text="{Binding TaxonomyText}"
                           Foreground="{StaticResource MintBrush}"
                           FontSize="{StaticResource FontSizeMicro}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="card-provider"
                           Text="{Binding ProviderText}"
                           IsVisible="{Binding HasProviders}"
                           Foreground="{StaticResource AccentTextBrush}"
                           FontSize="{StaticResource FontSizeMicro}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>

            <Grid Classes="card-actions"
                  RowDefinitions="*,Auto"
                  ColumnDefinitions="*,Auto"
                  IsVisible="{Binding !IsOnline}">
              <Button Grid.Row="1"
                      Classes="card-action"
                      Content="{Binding ProgressText}"
                      Command="{Binding ContinueCommand}"
                      IsVisible="{Binding HasProgress}"
                      HorizontalAlignment="Left"
                      MaxWidth="226"
                      ToolTip.Tip="{Binding ProgressText}" />
              <Button Grid.Row="1"
                      Grid.Column="1"
                      Classes="card-action favorite-action"
                      Content="{Binding FavoriteGlyph}"
                      Command="{Binding ToggleFavoriteCommand}"
                      IsVisible="{Binding CanToggleFavorite}"
                      AutomationProperties.Name="{Binding FavoriteActionText}"
                      ToolTip.Tip="{Binding FavoriteActionText}" />
            </Grid>
          </Grid>
        </Border>
      </Button>
    </DataTemplate>

    <!-- One shelf: a heading, its count, an optional way past it, and the row
         itself. Shared by home and by the movies / anime / books pages so all
         four read as the same surface. -->
    <DataTemplate x:Key="CatalogShelfTemplate"
                  x:DataType="vm:CatalogSectionViewModel">
      <StackPanel Margin="0,0,0,26" Spacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="title"
                     Text="{Binding Title}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Classes="hint"
                     Text="{Binding CountText}"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center" />
          <Button Grid.Column="2"
                  Classes="quiet shelf-see-all"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center"
                  Content="{DynamicResource HomeSeeAll}"
                  Command="{Binding SeeAllCommand}"
                  IsVisible="{Binding CanSeeAll}" />
        </Grid>
        <!-- The chevrons are the only way a wheel-only mouse can move a row,
             so they overlay its edges rather than taking layout space. A
             remote never sees them: it moves the row by moving focus along
             it. -->
        <Grid Classes="shelf-host">
          <ScrollViewer Classes="shelf">
            <ItemsControl Classes="catalog-row"
                          ItemsSource="{Binding Items}"
                          ItemTemplate="{StaticResource CatalogCardTemplate}" />
          </ScrollViewer>
          <Button Classes="shelf-nav shelf-previous"
                  HorizontalAlignment="Left"
                  Content="&#xE76B;"
                  AutomationProperties.Name="{DynamicResource ShelfScrollLeft}"
                  ToolTip.Tip="{DynamicResource ShelfScrollLeft}" />
          <Button Classes="shelf-nav shelf-next"
                  HorizontalAlignment="Right"
                  Content="&#xE76C;"
                  AutomationProperties.Name="{DynamicResource ShelfScrollRight}"
                  ToolTip.Tip="{DynamicResource ShelfScrollRight}" />
        </Grid>
      </StackPanel>
    </DataTemplate>

    <!-- Shared by ordinary source groups and the media subgroups inside API
         providers. Keeping one row template means every setting behaves the
         same no matter how it is categorized. -->
    <DataTemplate x:Key="ContentSourceProviderRowTemplate"
                  x:DataType="vm:ContentSourceProviderRowViewModel">
      <Border Classes="inner-card"
              Margin="0,0,0,12">
        <StackPanel Spacing="12">
          <Grid Classes="settings-row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <StackPanel Classes="settings-provider-identity"
                        Spacing="12"
                        VerticalAlignment="Center">
              <Border Classes="chip">
                <TextBlock Text="{Binding KindLabel}"
                           Foreground="{StaticResource AccentTextBrush}"
                           FontSize="{StaticResource FontSizeMicro}"
                           FontWeight="Bold" />
              </Border>
              <TextBlock Text="{Binding DisplayName}"
                         IsVisible="{Binding IsLiveTv}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <CheckBox Classes="provider-enabled-toggle"
                        Content="{DynamicResource Enabled}"
                        Focusable="True"
                        IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                        IsEnabled="{Binding !IsManual}" />
            </StackPanel>
            <Button Classes="quiet danger settings-secondary"
                    Content="{DynamicResource Remove}"
                    Command="{Binding RemoveCommand}"
                    IsVisible="{Binding CanDelete}"
                    IsEnabled="{Binding !IsManual}" />
          </Grid>
          <StackPanel Spacing="6"
                      IsVisible="{Binding ShowsConfigurationFields}">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource ContentSourceNameLabel}" />
            <TextBox Text="{Binding DisplayName}"
                     IsReadOnly="{Binding !CanEditName}"
                     AutomationProperties.Name="{DynamicResource ContentSourceNameLabel}" />
          </StackPanel>
          <StackPanel Spacing="6"
                      IsVisible="{Binding ShowsConfigurationFields}">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource ContentSourceBaseUrlLabel}" />
            <TextBox Text="{Binding BaseUrl}"
                     IsReadOnly="{Binding !CanEditBaseUrl}"
                     AutomationProperties.Name="{DynamicResource ContentSourceBaseUrlLabel}"
                     PlaceholderText="https://provider.example/api" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- Keep responsive values in styles: local XAML values would prevent the
         phone rules from reclaiming the space consumed by desktop gutters. -->
    <Style Selector="Border#SettingsCard">
      <Setter Property="Margin" Value="36" />
    </Style>
    <Style Selector="Grid#SettingsHeader">
      <Setter Property="Margin" Value="26,22,26,10" />
    </Style>
    <Style Selector="StackPanel#SettingsContent">
      <Setter Property="Margin" Value="26,0,26,26" />
    </Style>
    <Style Selector="Border.settings-card">
      <Setter Property="Padding" Value="22" />
    </Style>
    <Style Selector="Button#ImportCatalogButton, Button#CreateBackupButton">
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="Button#ExportCatalogButton, Button#RestoreBackupButton">
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="Grid.settings-row > :is(Control).settings-secondary">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Grid.Row" Value="0" />
    </Style>
    <Style Selector="Grid.settings-row > :is(Control).settings-tertiary">
      <Setter Property="Grid.Column" Value="2" />
      <Setter Property="Grid.Row" Value="0" />
    </Style>
    <Style Selector="StackPanel.settings-provider-identity">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>
    <Style Selector="UniformGrid.settings-account-fields">
      <Setter Property="Columns" Value="4" />
    </Style>
    <Style Selector="StackPanel.settings-account-field">
      <Setter Property="Margin" Value="0,0,10,12" />
    </Style>
    <Style Selector="Grid#Shell.compact Border#SettingsCard">
      <Setter Property="Margin" Value="12" />
    </Style>
    <Style Selector="Grid#Shell.compact Grid#SettingsHeader">
      <Setter Property="Margin" Value="16,12" />
    </Style>
    <Style Selector="Grid#Shell.compact StackPanel#SettingsContent">
      <Setter Property="Margin" Value="12,0,12,16" />
    </Style>
    <Style Selector="Grid#Shell.compact Border.settings-card">
      <Setter Property="Padding" Value="14" />
    </Style>
    <!-- Empty Auto columns collapse when every child moves into column zero;
         nothing spans them, so labels and inputs retain the full card width. -->
    <Style Selector="Grid#Shell.compact Grid.settings-row">
      <Setter Property="RowSpacing" Value="10" />
    </Style>
    <Style Selector="Grid#Shell.compact Grid.settings-row > :is(Control).settings-secondary">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="1" />
    </Style>
    <Style Selector="Grid#Shell.compact Grid.settings-row > :is(Control).settings-tertiary">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="2" />
    </Style>
    <Style Selector="Grid#Shell.compact UniformGrid.settings-account-fields">
      <Setter Property="Columns" Value="2" />
    </Style>
    <Style Selector="Grid#Shell.narrow Border#SettingsCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Grid#Shell.narrow UniformGrid.settings-account-fields">
      <Setter Property="Columns" Value="1" />
    </Style>
    <Style Selector="Grid#Shell.narrow StackPanel.settings-account-field">
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="Grid#Shell.narrow StackPanel.settings-provider-identity">
      <Setter Property="Orientation" Value="Vertical" />
    </Style>
    <Style Selector="Grid#Shell.compact Grid#SettingsOverlay TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Grid#Shell.compact Grid#SettingsOverlay Button /template/ ContentPresenter, Grid#Shell.compact Grid#SettingsOverlay CheckBox /template/ ContentPresenter">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Grid#Shell.touch Grid#SettingsOverlay Button, Grid#Shell.touch Grid#SettingsOverlay TextBox, Grid#Shell.touch Grid#SettingsOverlay ComboBox, Grid#Shell.touch Grid#SettingsOverlay CheckBox">
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <!-- Shell defaults live in styles, never as local attribute values, so the
         compact / narrow / touch / tv layers below can actually override them. -->
    <Style Selector="Border#Sidebar">
      <Setter Property="Padding" Value="16,20" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="StackPanel#PrimaryNavigation">
      <Setter Property="Margin" Value="0,26,0,0" />
    </Style>
    <Style Selector="StackPanel#SidebarFooter">
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <!-- Sidebar navigation: soft pills that light up on hover and stay tinted
         while their section is active. -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="MinHeight" Value="46" />
    </Style>
    <Style Selector="Button.nav /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button:focus-visible, Grid#Shell.tv Button:focus">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.nav:focus-visible /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoftHoverBrush}" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.nav.active TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    </Style>
    <Style Selector="PathIcon.nav-icon">
      <Setter Property="Width" Value="21" />
      <Setter Property="Height" Value="21" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.nav.active PathIcon.nav-icon">
      <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover PathIcon.nav-icon">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.nav-label">
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid#Shell.nav-collapsed Border#Sidebar">
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Grid#Shell.nav-collapsed TextBlock.nav-label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Shell.nav-collapsed StackPanel#BrandText">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Shell.nav-collapsed Border#BrandMark">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Shell.nav-collapsed Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="10" />
    </Style>

    <!-- Catalog cards -->
    <Style Selector="Border.catalog-card">
      <Setter Property="Width" Value="300" />
      <Setter Property="Height" Value="340" />
      <Setter Property="Margin" Value="0,0,16,16" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
          <TransformOperationsTransition Property="RenderTransform"
                                         Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.catalog-card:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource BorderAccentBrush}" />
      <Setter Property="BoxShadow" Value="{StaticResource ShadowSoft}" />
    </Style>
    <Style Selector="Grid.card-content">
      <Setter Property="Margin" Value="18" />
    </Style>
    <Style Selector="Grid.card-actions">
      <Setter Property="Margin" Value="18" />
    </Style>
    <Style Selector="StackPanel.card-text">
      <Setter Property="Spacing" Value="7" />
      <Setter Property="Margin" Value="0,0,0,46" />
    </Style>
    <Style Selector="Button.catalog-card-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ItemsControl.catalog-grid">
      <Setter Property="ItemsPanel"
              Value="{StaticResource CatalogWrapPanel}" />
    </Style>
    <Style Selector="ItemsControl.catalog-row">
      <Setter Property="ItemsPanel"
              Value="{StaticResource CatalogRowPanel}" />
    </Style>
    <!-- The shelf scrolls sideways and never vertically: vertical travel is
         how the viewer moves between shelves, and a row that also scrolled up
         would swallow that. -->
    <Style Selector="ScrollViewer.shelf">
      <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <!-- Chevrons sit over the ends of a row. They stay out of the way until the
         pointer is on the shelf, and out of the tab and remote order entirely:
         a keyboard or remote moves the row by moving along its cards. -->
    <Style Selector="Button.shelf-nav">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6,0,6,16" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Grid.shelf-host:pointerover Button.shelf-nav">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Grid.shelf-host:pointerover Button.shelf-nav:pointerover">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderAccentBrush}" />
    </Style>
    <!-- A row already at its end offers nothing to press. -->
    <Style Selector="Button.shelf-nav:disabled">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- A television has no pointer, so the chevrons would only ever be dead
         weight over the first and last poster of every row. -->
    <Style Selector="Grid#Shell.tv Button.shelf-nav">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- List membership is hidden on a television rather than shrunk to fit.
         It is driven by a ComboBox, and a dropdown captures focus with no clean
         Back semantics on a remote — the whole block goes, so the beam never
         finds a control it cannot get back out of. Lists stay reachable from
         the user lists page. -->
    <Style Selector="Grid#Shell.tv Border#DetailsListMembershipPanel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- The focused poster lifts out of the row. At three metres a two-pixel
         border is not enough on its own to say where you are. -->
    <Style Selector="Button.catalog-card-button Border.catalog-card">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    </Style>
    <Style Selector="Grid#Shell.tv Button.catalog-card-button:focus Border.catalog-card">
      <Setter Property="RenderTransform" Value="scale(1.06)" />
      <Setter Property="ZIndex" Value="10" />
    </Style>
    <Style Selector="Button.catalog-card-button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.catalog-card-button:focus-visible /template/ ContentPresenter, Grid#Shell.tv Button.catalog-card-button:focus /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Keep the focus ring on the poster itself so nothing shifts, and make it
         unmistakable for remote-control and keyboard navigation. -->
    <Style Selector="Button.catalog-card-button:focus-visible, Grid#Shell.tv Button.catalog-card-button:focus">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.catalog-card-button:focus-visible Border.catalog-card, Grid#Shell.tv Button.catalog-card-button:focus Border.catalog-card">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BoxShadow" Value="{StaticResource ShadowSoft}" />
    </Style>
    <Style Selector="Button.live-tv-channel">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.live-tv-channel:pointerover Border.live-tv-row">
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderAccentBrush}" />
    </Style>
    <Style Selector="Button.live-tv-channel:focus-visible, Grid#Shell.tv Button.live-tv-channel:focus">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.live-tv-channel:focus-visible Border.live-tv-row, Grid#Shell.tv Button.live-tv-channel:focus Border.live-tv-row">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ListBox#LiveTvChannelList ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="ListBox#LiveTvChannelList ListBoxItem:selected Border.live-tv-row">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="StackPanel.live-tv-search-container">
      <Setter Property="Width" Value="360" />
      <Setter Property="MaxWidth" Value="360" />
    </Style>
    <Style Selector="StackPanel.live-tv-filter-field">
      <Setter Property="Width" Value="220" />
    </Style>
    <Style Selector="Grid.live-tv-thumb, Border.live-tv-thumb">
      <Setter Property="Width" Value="120" />
      <Setter Property="Height" Value="68" />
    </Style>
    <Style Selector="Grid#Shell.tv Button.catalog-card-button:focus Border.catalog-card">
      <Setter Property="BorderThickness" Value="3" />
      <Setter Property="BoxShadow" Value="{StaticResource ShadowFloating}" />
    </Style>
    <!-- A TV card is one remote target. Its pointer-only quick actions remain
         available on desktop/mobile, while the detail page exposes the same
         actions as full-sized TV buttons. Nested focus targets otherwise make
         directional navigation jump unpredictably between rows. -->
    <Style Selector="Grid#Shell.tv Button.catalog-card-button Button.card-action">
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.card-action">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="{StaticResource BadgeScrimBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.card-action:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Button.favorite-action">
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="19" />
    </Style>

    <!-- Panels -->
    <Style Selector="Border.surface">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    </Style>
    <Style Selector="Border.surface.hero">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
    </Style>
    <Style Selector="Border#SettingsCard">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
    </Style>
    <Style Selector="Grid#Shell.narrow Border#SettingsCard">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.surface.entry-card">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.surface.entry-card:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    </Style>

    <!-- The chosen season, marked on the button itself so the row shows where
         you are without a popup having to be opened to find out. -->
    <Style Selector="Button.season-chip.active">
      <Setter Property="Background" Value="{StaticResource AccentChipBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Button.quiet colours the presenter rather than the button, so the
         chosen season has to be coloured there too or it would stay grey. -->
    <Style Selector="Button.season-chip.active /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    </Style>

    <!-- Where one season ends and the next begins. A rule down the left rather
         than a full card, so it reads as a divider between the episodes it
         separates instead of as another row among them. -->
    <Style Selector="Border.season-header">
      <Setter Property="Margin" Value="0,10,0,14" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="{StaticResource AccentChipBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="4,0,0,0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>
    <Style Selector="Border.season-header TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    </Style>

    <!-- Nested card inside a panel -->
    <Style Selector="Border.inner-card">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Inline notices -->
    <Style Selector="Border.notice">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
    </Style>
    <Style Selector="Border.notice.danger">
      <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
    </Style>
    <Style Selector="Border.notice.positive">
      <Setter Property="Background" Value="{StaticResource MintSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource MintBorderBrush}" />
    </Style>
    <Style Selector="Border.notice.warning">
      <Setter Property="Background" Value="{StaticResource AmberSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AmberBorderBrush}" />
    </Style>

    <!-- Badges and chips -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{StaticResource AccentChipBrush}" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip.outline">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.chip.mint">
      <Setter Property="Background" Value="{StaticResource MintScrimBrush}" />
    </Style>

    <!-- Overview tiles -->
    <Style Selector="Border.stat">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
      <Setter Property="Padding" Value="18,16" />
      <Setter Property="Margin" Value="0,0,14,0" />
    </Style>

    <!-- Compact (narrow window / phone) shell. Row placement and the divider
         edge are set in code-behind, which knows whether the bar sits on top
         (small desktop window) or at the bottom (touch device). -->
    <Style Selector="Grid#Shell.compact Border#Sidebar">
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Grid#Shell.compact StackPanel#BrandText">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Shell.compact Grid#BrandHeader">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Shell.compact TextBlock.nav-label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Shell.compact Button#NavigationToggleButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Shell.compact Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Grid#Shell.compact StackPanel#PrimaryNavigation">
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid#Shell.compact StackPanel#SecondaryNavigation">
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style Selector="Grid#Shell.compact StackPanel#SidebarFooter">
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Grid#Shell.compact StackPanel.metadata-field">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="Grid#Shell.compact StackPanel#MalSettings">
      <Setter Property="Grid.Row" Value="1" />
    </Style>
    <Style Selector="Grid#Shell.compact StackPanel#MalUnavailable">
      <Setter Property="Grid.Row" Value="1" />
    </Style>
    <Style Selector="Grid#Shell.compact StackPanel#LanguageSettings">
      <Setter Property="Grid.Row" Value="2" />
    </Style>
    <Style Selector="Grid#Shell.compact Button#SaveMetadataButton">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Grid#Shell.compact StackPanel#CatalogDataDescription">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="0" />
    </Style>
    <Style Selector="Grid#Shell.compact Button#ImportCatalogButton">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Margin" Value="0,14,0,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Grid#Shell.compact Button#ExportCatalogButton">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="2" />
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Grid#Shell.compact StackPanel#BackupDescription">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="0" />
    </Style>
    <Style Selector="Grid#Shell.compact Button#CreateBackupButton">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Margin" Value="0,14,0,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Grid#Shell.compact Button#RestoreBackupButton">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="2" />
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Touch shells (phone, tablet, or a handset-sized browser window):
         every target grows to a comfortable finger size. -->
    <Style Selector="Grid#Shell.touch Button:not(.catalog-card-button)">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="18,11" />
    </Style>
    <Style Selector="Grid#Shell.touch Button.nav">
      <Setter Property="MinHeight" Value="52" />
    </Style>
    <Style Selector="Grid#Shell.touch TextBox">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
    </Style>
    <Style Selector="Grid#Shell.touch ComboBox">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
    </Style>
    <Style Selector="Grid#Shell.touch CheckBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
    </Style>
    <Style Selector="Grid#Shell.touch TextBlock.body">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
      <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style Selector="Grid#Shell.touch TextBlock.hint">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style Selector="Grid#Shell.touch TextBlock.field-label">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>
    <Style Selector="Grid#Shell.touch Button.activity-action">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="16,9" />
    </Style>
    <Style Selector="Grid#Shell.touch Button.reader-mode">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="16,9" />
    </Style>
    <Style Selector="Grid#Shell.touch Button.reader-nav">
      <Setter Property="MinHeight" Value="50" />
    </Style>
    <!-- Reader chrome is revealed by tapping, so give the strip real height. -->
    <Style Selector="Grid#Shell.touch Border#ReaderTopHoverZone">
      <Setter Property="Height" Value="64" />
    </Style>
    <Style Selector="Grid#Shell.touch Button#ScrollToTopButton">
      <Setter Property="Width" Value="54" />
      <Setter Property="Height" Value="54" />
      <Setter Property="CornerRadius" Value="27" />
    </Style>

    <!-- Where a friend card's parts sit on a roomy shell. Set here rather than
         on the elements because a value written in the markup outranks a style,
         and the phone-sized rules below have to be able to move them. -->
    <Style Selector="WrapPanel.friend-actions">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Grid.ColumnSpan" Value="1" />
      <Setter Property="Grid.Row" Value="0" />
    </Style>
    <!-- A name that goes looking for itself: styled as text rather than a
         button so the row still reads as a list, but coloured to say it can
         be pressed. -->
    <Style Selector="Button.friend-title">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground"
              Value="{StaticResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.friend-title:disabled">
      <Setter Property="Foreground"
              Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="StackPanel.friend-shared">
      <Setter Property="Grid.Row" Value="2" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>

    <!-- Phone-sized shells: two poster columns, a thumb-reachable bar, and
         cards trimmed to what is readable at this width. -->
    <Style Selector="Grid#Shell.narrow Border#Sidebar">
      <Setter Property="Padding" Value="6,8" />
    </Style>
    <Style Selector="Grid#Shell.narrow Button.nav">
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>
    <Style Selector="Grid#Shell.narrow StackPanel#PrimaryNavigation">
      <Setter Property="Spacing" Value="2" />
    </Style>
    <Style Selector="Grid#Shell.narrow StackPanel#SecondaryNavigation">
      <Setter Property="Spacing" Value="2" />
      <Setter Property="Margin" Value="2,0,0,0" />
    </Style>
    <Style Selector="Grid#Shell.narrow StackPanel#SidebarFooter">
      <Setter Property="Spacing" Value="2" />
    </Style>
    <Style Selector="Grid#Shell.narrow PathIcon.nav-icon">
      <Setter Property="Width" Value="23" />
      <Setter Property="Height" Value="23" />
      <Setter Property="Margin" Value="4,0" />
    </Style>
    <Style Selector="Grid#Shell.narrow Border.catalog-card">
      <Setter Property="Width" Value="168" />
      <Setter Property="Height" Value="252" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
      <Setter Property="Margin" Value="0,0,10,10" />
    </Style>
    <Style Selector="Grid#Shell.narrow Grid.card-content">
      <Setter Property="Margin" Value="12" />
    </Style>
    <Style Selector="Grid#Shell.narrow Grid.card-actions">
      <Setter Property="Margin" Value="12" />
    </Style>
    <Style Selector="Grid#Shell.narrow StackPanel.card-text">
      <Setter Property="Spacing" Value="4" />
      <Setter Property="Margin" Value="0,0,0,44" />
    </Style>
    <Style Selector="Grid#Shell.narrow Button.card-action">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    </Style>
    <Style Selector="Grid#Shell.narrow TextBlock.card-title">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
      <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style Selector="Grid#Shell.narrow TextBlock.card-description">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Shell.narrow TextBlock.card-provider">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- A handset has no room for a friend's name and their controls side by
         side: the name column collapses to nothing and the "progress shared"
         line is clipped mid-word. Stack the card instead — one column, controls
         on the row below the name.

         Nothing may span the two columns once stacked. A spanning child hands
         part of its width to the automatic second column, which starves the
         name column just as badly and wraps the label one word per line. With
         every child in the first column the second holds nothing and collapses,
         so the first is the whole card. -->
    <Style Selector="Grid#Shell.narrow WrapPanel.friend-actions">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style Selector="Grid#Shell.narrow StackPanel.friend-shared">
      <Setter Property="Grid.ColumnSpan" Value="1" />
    </Style>
    <Style Selector="Grid#Shell.narrow Border.download-card">
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Grid#Shell.narrow StackPanel.live-tv-search-container">
      <Setter Property="Width" Value="240" />
      <Setter Property="MaxWidth" Value="240" />
    </Style>
    <Style Selector="Grid#Shell.narrow StackPanel.live-tv-filter-field">
      <Setter Property="Width" Value="240" />
    </Style>
    <Style Selector="Grid#Shell.narrow Grid.live-tv-thumb, Grid#Shell.narrow Border.live-tv-thumb">
      <Setter Property="Width" Value="84" />
      <Setter Property="Height" Value="48" />
    </Style>
    <!-- The whole row is already the button, so on a handset the Watch chip is
         costing the channel name a third of the width to say so again. -->
    <Style Selector="Grid#Shell.narrow Border.live-tv-action">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Shell.narrow Border.live-tv-action">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Shell.narrow Border.torrent-activity">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MaxWidth" Value="560" />
      <Setter Property="Margin" Value="12" />
    </Style>

    <!-- Television shell: everything grows for ten-foot viewing and focus is
         impossible to lose track of from the couch. -->
    <Style Selector="Grid#Shell.tv Border#Sidebar">
      <Setter Property="Padding" Value="26,32" />
      <Setter Property="Width" Value="300" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="BoxShadow" Value="{StaticResource ShadowFloating}" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <!-- Collapsed television rail. The menu arrow shrinks it to icons;
         pressing left from content brings the full menu back. -->
    <Style Selector="Grid#Shell.tv-rail Border#Sidebar">
      <Setter Property="Padding" Value="18,32" />
      <Setter Property="Width" Value="104" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Grid#Shell.tv-rail TextBlock.nav-label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Shell.tv-rail StackPanel#BrandText">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Shell.tv-rail Button#NavigationToggleButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Shell.tv-rail Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Grid#Shell.tv Button:not(.catalog-card-button)">
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Padding" Value="20,12" />
      <!-- Reserve the focus-ring space at all times. Changing this value only
           while focused remeasures a tall page for every remote press. -->
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="Grid#Shell.tv Button:not(.catalog-card-button):focus /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="Grid#Shell.tv Button.nav">
      <Setter Property="Padding" Value="18,15" />
      <Setter Property="FontSize" Value="19" />
      <Setter Property="MinHeight" Value="62" />
    </Style>
    <Style Selector="Grid#Shell.tv Button#DonationDismissButton:focus /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Grid#Shell.tv PathIcon.nav-icon">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
    </Style>
    <Style Selector="Grid#Shell.tv StackPanel#PrimaryNavigation">
      <Setter Property="Spacing" Value="8" />
    </Style>
    <!-- A row card needs an intrinsic width: it no longer stretches to fill a
         grid column, it sits in a horizontal run. Larger than the desktop card
         because this one is read from across a room. -->
    <Style Selector="Grid#Shell.tv Border.catalog-card">
      <Setter Property="Width" Value="332" />
      <Setter Property="Height" Value="376" />
      <Setter Property="Margin" Value="0,0,20,16" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
          <TransformOperationsTransition Property="RenderTransform"
                                         Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <!-- A short, restrained lift keeps the focused poster clear without
         obscuring its neighbours or making quick D-pad runs feel bouncy. -->
    <Style Selector="Grid#Shell.tv Button.catalog-card-button:focus Border.catalog-card">
      <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>
    <Style Selector="Grid#Shell.tv ItemsControl.catalog-grid">
      <Setter Property="ItemsPanel"
              Value="{StaticResource TelevisionCatalogGridPanel}" />
    </Style>
    <!-- Ten-foot type scale -->
    <Style Selector="Grid#Shell.tv TextBlock.display">
      <Setter Property="FontSize" Value="38" />
    </Style>
    <Style Selector="Grid#Shell.tv TextBlock.title">
      <Setter Property="FontSize" Value="27" />
    </Style>
    <Style Selector="Grid#Shell.tv TextBlock.subtitle">
      <Setter Property="FontSize" Value="22" />
    </Style>
    <Style Selector="Grid#Shell.tv TextBlock.body">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="LineHeight" Value="27" />
    </Style>
    <Style Selector="Grid#Shell.tv TextBlock.hint">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style Selector="Grid#Shell.tv TextBlock.field-label">
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Grid#Shell.tv TextBlock.micro">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style Selector="Grid#Shell.tv TextBlock.eyebrow">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Grid#Shell.tv TextBlock.card-title">
      <Setter Property="FontSize" Value="23" />
      <Setter Property="LineHeight" Value="28" />
    </Style>
    <Style Selector="Grid#Shell.tv TextBlock.card-description">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Grid#Shell.tv TextBlock.card-taxonomy">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Grid#Shell.tv TextBlock.card-provider">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Grid#Shell.tv Border.stat">
      <Setter Property="Padding" Value="22,20" />
    </Style>
    <Style Selector="Grid#Shell.tv Border.chip">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Grid#Shell.tv Grid.card-content">
      <Setter Property="Margin" Value="20" />
    </Style>
    <Style Selector="Grid#Shell.tv Grid.card-actions">
      <Setter Property="Margin" Value="20" />
    </Style>
    <Style Selector="Grid#Shell.tv StackPanel.card-text">
      <Setter Property="Margin" Value="0,0,0,52" />
    </Style>
    <Style Selector="Grid#Shell.tv Button.card-action">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <!-- Constrain the episode/chapter list on a television. Without a finite
         viewport the virtualizing panel is measured at infinite height and
         creates every nested control, which can block Android TV input for
         several seconds on long series. -->
    <Style Selector="Grid#Shell.tv ListBox#DetailsEntriesList">
      <Setter Property="Height" Value="650" />
    </Style>
    <Style Selector="ListBox#DetailsEntriesList">
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox#DetailsEntriesList ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <!-- A pointer acts on the chapter's buttons, not on a selectable row.
         Keep list focus and its selection feedback for television navigation. -->
    <Style Selector="Grid#Shell:not(.tv) ListBox#DetailsEntriesList">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
    </Style>
    <Style Selector="Grid#Shell:not(.tv) ListBox#DetailsEntriesList ListBoxItem">
      <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
    </Style>
    <Style Selector="Grid#Shell:not(.tv) ListBox#DetailsEntriesList ListBoxItem /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- Focus you can read across the room -->
    <Style Selector="Grid#Shell.tv Button:focus /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoftHoverBrush}" />
    </Style>
    <Style Selector="Grid#Shell.tv Button.nav:focus /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Grid#Shell.tv Button.nav:focus TextBlock">
      <Setter Property="Foreground" Value="#15192B" />
    </Style>
    <Style Selector="Grid#Shell.tv Button.nav:focus PathIcon.nav-icon">
      <Setter Property="Foreground" Value="#15192B" />
    </Style>
    <Style Selector="Grid#Shell.tv CheckBox.provider-enabled-toggle:focus">
      <Setter Property="Background"
              Value="{StaticResource AccentSoftHoverBrush}" />
      <Setter Property="BorderBrush"
              Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- Reader chrome -->
    <Style Selector="Button#ReaderSettingsButton.active">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderAccentBrush}" />
    </Style>
    <Style Selector="Grid#Shell.tv Border#ReaderSettingsPanel TextBlock">
      <Setter Property="FontSize" Value="20" />
    </Style>
    <Style Selector="Grid#Shell.tv Border#ReaderSettingsPanel TextBlock.hint">
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Grid#Shell.tv Border#ReaderSettingsPanel Button">
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="FontSize" Value="20" />
    </Style>
    <Style Selector="Border#ReaderSettingsPanel Slider:focus-visible">
      <Setter Property="Background" Value="{StaticResource AccentScrimBrush}" />
    </Style>
    <Style Selector="Border.reader-toolbar">
      <Setter Property="Background" Value="{StaticResource ScrimBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="20,14" />
    </Style>
    <Style Selector="Border.reader-footer">
      <Setter Property="Background" Value="{StaticResource ScrimBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="20,14" />
    </Style>
    <Style Selector="Border#ReaderTopHoverZone">
      <Setter Property="Height" Value="28" />
    </Style>
    <!-- A hairline, not a control: it reports that something is happening
         without asking to be looked at, and without reserving height that would
         push the window's content down every time work starts. -->
    <Style Selector="ListBox#ReaderPages.virtualized-pages">
      <Setter Property="ItemsPanel"
              Value="{StaticResource ReaderVirtualizedPagePanel}" />
    </Style>
    <Style Selector="Button.profile-tile">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    </Style>
    <Style Selector="Button.profile-tile:pointerover">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Border.profile-avatar">
      <Setter Property="Width" Value="104" />
      <Setter Property="Height" Value="104" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ProgressBar.global-busy">
      <Setter Property="Height" Value="3" />
      <Setter Property="MinHeight" Value="3" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Button#ScrollToTopButton">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
      <Setter Property="CornerRadius" Value="23" />
    </Style>
    <Style Selector="Border.reader-chapter-nav">
      <Setter Property="Background" Value="{StaticResource OverlayBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="BoxShadow" Value="{StaticResource ShadowSoft}" />
      <Setter Property="Opacity" Value="0.94" />
    </Style>
    <Style Selector="Border.reader-chapter-nav:pointerover">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderAccentBrush}" />
    </Style>
    <Style Selector="Button.reader-nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.reader-nav.manga">
      <Setter Property="Background" Value="{StaticResource AccentChipBrush}" />
      <Setter Property="Margin" Value="6,0" />
    </Style>
    <Style Selector="Button.reader-nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoftHoverBrush}" />
    </Style>
    <Style Selector="Border.reader-chapter-nav#ReaderChapterNavigationBanner">
      <Setter Property="MaxWidth" Value="450" />
      <Setter Property="Background" Value="#2B2C34" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BoxShadow" Value="0 8 28 0 #70000000" />
    </Style>
    <Style Selector="Button.reader-dock">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="#393A43" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.reader-dock.accent">
      <Setter Property="Background" Value="#3575DC" />
    </Style>
    <Style Selector="Button.reader-dock /template/ ContentPresenter">
      <Setter Property="Background" Value="#393A43" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.reader-dock.accent /template/ ContentPresenter">
      <Setter Property="Background" Value="#3575DC" />
    </Style>
    <Style Selector="Button.reader-dock:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#393A43" />
    </Style>
    <Style Selector="Button.reader-dock.chapter">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.reader-dock PathIcon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.reader-dock:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#49628A" />
    </Style>
    <Style Selector="Button.reader-dock.active /template/ ContentPresenter">
      <Setter Property="Background" Value="#49628A" />
    </Style>
    <Style Selector="Button.reader-dock:focus-visible /template/ ContentPresenter, Grid#Shell.tv Button.reader-dock:focus /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="White" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Grid#Shell.touch Button.reader-dock">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="Grid#Shell.touch Button.reader-dock.chapter">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Grid#Shell.touch Button.reader-dock.chapter PathIcon">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#ReaderDockButtons, Grid#ReaderChapterLabelLayout">
      <Setter Property="ColumnSpacing" Value="8" />
    </Style>
    <Style Selector="Grid#Shell.touch Grid#ReaderDockButtons">
      <Setter Property="ColumnSpacing" Value="4" />
    </Style>
    <Style Selector="Grid#Shell.touch Grid#ReaderChapterLabelLayout">
      <Setter Property="ColumnSpacing" Value="0" />
    </Style>
    <Style Selector="Grid#Shell.touch Button#ReaderFullscreenButton, Grid#Shell.tv Button#ReaderFullscreenButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Shell.tv Button.reader-dock">
      <Setter Property="Width" Value="60" />
      <Setter Property="Height" Value="60" />
      <Setter Property="MinHeight" Value="60" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Grid#Shell.tv Border#ReaderChapterNavigationBanner">
      <Setter Property="MaxWidth" Value="580" />
    </Style>
    <Style Selector="Grid#Shell.tv Button.reader-dock.chapter">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Padding" Value="14,0" />
    </Style>

    <!-- Segmented controls (page mode, zoom, font size) -->
    <Style Selector="Border.segmented-control">
      <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="Button.reader-mode">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.reader-mode /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.reader-mode.active">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.reader-mode.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.reader-mode:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Floating download activity card -->
    <Style Selector="Border.torrent-activity">
      <Setter Property="Width" Value="470" />
      <Setter Property="MaxWidth" Value="470" />
      <Setter Property="Margin" Value="20" />
      <Setter Property="Background" Value="{StaticResource OverlayBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="BoxShadow" Value="{StaticResource ShadowFloating}" />
    </Style>
    <Style Selector="Button.activity-action">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="13,6" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>

    <!-- Download list -->
    <Style Selector="Border.download-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.download-card:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
    </Style>

    <!-- Phone chrome. Both float over the page, so the content stays visible
         through them; code-behind owns their visibility. -->
    <Style Selector="Border.page-options">
      <Setter Property="Background" Value="{StaticResource PageOptionsBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="0,0,0,20" />
      <Setter Property="BoxShadow" Value="{StaticResource ShadowFloating}" />
    </Style>
    <!-- A fixed 520 was wider than a phone, so the prompt hung off the left
         edge with its heading and buttons cut. It fills the width it has and
         stops at 520 on anything larger. -->
    <Style Selector="Grid#Shell.narrow Border#UpdatePrompt">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <!-- No lift for ReaderPageOptionsBar here any more. It shared an edge with
         the chapter navigation and was pushed clear of it by a margin, which
         the code-behind then overwrote whenever it set its own offset — a
         direct set outranks a style setter, so this never took effect.
         ReaderBottomBars stacks the two instead. -->
    <Style Selector="Grid#Shell.narrow Border#EpubPageOptionsBar">
      <Setter Property="Margin" Value="0,0,0,96" />
    </Style>
    <Style Selector="Border#MenuScrim">
      <Setter Property="Background" Value="{StaticResource DrawerScrimBrush}" />
    </Style>
    <Style Selector="Button#MenuButton">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Background" Value="{StaticResource PageOptionsBrush}" />
    </Style>
    <!-- Drawer presentation: a panel that slides over the page, not a column. -->
    <Style Selector="Grid#Shell.drawer-nav Border#Sidebar">
      <Setter Property="Width" Value="272" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="BoxShadow" Value="{StaticResource ShadowFloating}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Grid#Shell.drawer-nav StackPanel#PrimaryNavigation">
      <Setter Property="Orientation" Value="Vertical" />
      <Setter Property="Margin" Value="0,26,0,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="Grid#Shell.drawer-nav StackPanel#SecondaryNavigation">
      <Setter Property="Orientation" Value="Vertical" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Grid#Shell.drawer-nav StackPanel#SidebarFooter">
      <Setter Property="Orientation" Value="Vertical" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style Selector="Grid#Shell.drawer-nav Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,11" />
    </Style>
    <Style Selector="Grid#Shell.drawer-nav TextBlock.nav-label">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Grid#Shell.drawer-nav StackPanel#BrandText">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Grid#Shell.drawer-nav Grid#BrandHeader">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Grid#Shell.drawer-nav Button#NavigationToggleButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="Shell"
        ColumnDefinitions="256,*"
        RowDefinitions="*"
        Background="{StaticResource BackdropBrush}">
    <Border x:Name="Sidebar"
            Grid.Column="0"
            ZIndex="60"
            Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}">
      <Grid x:Name="SidebarLayout"
            ColumnDefinitions="*"
            RowDefinitions="Auto,Auto,*,Auto,Auto">
        <Grid x:Name="BrandHeader"
              ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border x:Name="BrandMark"
                    Width="38"
                    Height="38"
                    Background="{StaticResource AccentSoftBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    VerticalAlignment="Center">
              <TextBlock Text="U"
                         Foreground="{StaticResource AccentTextBrush}"
                         FontSize="19"
                         FontWeight="Bold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <StackPanel x:Name="BrandText"
                        Spacing="2"
                        VerticalAlignment="Center">
              <TextBlock Text="UMD Library"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         FontSize="19"
                         FontWeight="Bold" />
              <TextBlock Text="{DynamicResource ShellSubtitle}"
                         Foreground="{StaticResource TextFaintBrush}"
                         FontSize="{StaticResource FontSizeCaption}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </StackPanel>
          <Button x:Name="NavigationToggleButton"
                   Grid.Column="1"
                   Classes="quiet"
                  Width="38"
                  Height="38"
                  MinHeight="38"
                  Padding="0"
                  CornerRadius="{StaticResource RadiusMd}"
                  VerticalAlignment="Center"
                   AutomationProperties.Name="{Binding NavigationToggleText}"
                   ToolTip.Tip="{Binding NavigationToggleText}"
                   Click="NavigationToggleButton_OnClick"
                   Command="{Binding ToggleNavigationCommand}">
            <TextBlock Text="{Binding NavigationToggleGlyph}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="20"
                       HorizontalAlignment="Center" />
          </Button>
        </Grid>

        <StackPanel x:Name="PrimaryNavigation"
                    Grid.Row="1"
                    Spacing="4">
          <Button x:Name="HomeNavButton"
                  Classes="nav"
                  Classes.active="{Binding IsAllSection}"
                  AutomationProperties.Name="{DynamicResource NavHome}"
                  ToolTip.Tip="{DynamicResource NavHome}"
                  Command="{Binding ShowAllCommand}">
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="nav-icon" Data="{StaticResource IconHome}" />
              <TextBlock Classes="nav-label" Text="{DynamicResource NavHome}" />
            </StackPanel>
          </Button>
          <Button x:Name="MoviesNavButton"
                  Classes="nav"
                  Classes.active="{Binding IsMoviesSection}"
                  AutomationProperties.Name="{DynamicResource NavMovies}"
                  ToolTip.Tip="{DynamicResource NavMovies}"
                  Command="{Binding ShowMoviesCommand}">
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="nav-icon" Data="{StaticResource IconMovies}" />
              <TextBlock Classes="nav-label" Text="{DynamicResource NavMovies}" />
            </StackPanel>
          </Button>
          <Button x:Name="AnimeNavButton"
                  Classes="nav"
                  Classes.active="{Binding IsAnimeSection}"
                  AutomationProperties.Name="{DynamicResource NavAnime}"
                  ToolTip.Tip="{DynamicResource NavAnime}"
                  Command="{Binding ShowAnimeCommand}">
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="nav-icon" Data="{StaticResource IconAnime}" />
              <TextBlock Classes="nav-label" Text="{DynamicResource NavAnime}" />
            </StackPanel>
          </Button>
          <Button x:Name="BooksNavButton"
                  Classes="nav"
                  Classes.active="{Binding IsBooksSection}"
                  AutomationProperties.Name="{DynamicResource NavBooks}"
                  ToolTip.Tip="{DynamicResource NavBooks}"
                  Command="{Binding ShowBooksCommand}">
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="nav-icon" Data="{StaticResource IconBooks}" />
              <TextBlock Classes="nav-label" Text="{DynamicResource NavBooks}" />
            </StackPanel>
          </Button>
          <Button x:Name="LiveTvNavButton"
                  Classes="nav"
                   Classes.active="{Binding IsLiveTvSection}"
                  AutomationProperties.Name="{DynamicResource NavLiveTv}"
                  ToolTip.Tip="{DynamicResource NavLiveTv}"
                  Command="{Binding ShowLiveTvCommand}">
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="nav-icon" Data="{StaticResource IconLiveTv}" />
              <TextBlock Classes="nav-label" Text="{DynamicResource NavLiveTv}" />
            </StackPanel>
          </Button>
          <Button x:Name="UserListsNavButton"
                  Classes="nav"
                  Classes.active="{Binding IsUserListsSection}"
                  AutomationProperties.Name="{DynamicResource NavLists}"
                  ToolTip.Tip="{DynamicResource NavLists}"
                  Command="{Binding ShowUserListsCommand}">
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="nav-icon" Data="{StaticResource IconLists}" />
              <TextBlock Classes="nav-label" Text="{DynamicResource NavLists}" />
            </StackPanel>
          </Button>
          <!-- Hidden until a signed-in server carries the features behind it.
               On a television the page holds only the watch party — friend
               management needs typing a remote is poor at — so the entry
               renames itself accordingly. -->
          <Button x:Name="FriendsNavButton"
                  Classes="nav"
                  Classes.active="{Binding IsFriendsSection}"
                  IsVisible="{Binding ShowFriendsNav}"
                  AutomationProperties.Name="{Binding FriendsNavLabel}"
                  ToolTip.Tip="{Binding FriendsNavLabel}"
                  Command="{Binding ShowFriendsCommand}">
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="nav-icon"
                        Data="{StaticResource IconFriends}" />
              <TextBlock Classes="nav-label"
                         Text="{Binding FriendsNavLabel}" />
            </StackPanel>
          </Button>
          <Button x:Name="DownloadsNavButton"
                  Classes="nav"
                  Classes.active="{Binding IsDownloadsSection}"
                  AutomationProperties.Name="{DynamicResource NavDownloads}"
                  ToolTip.Tip="{DynamicResource NavDownloads}"
                  Command="{Binding ShowDownloadsCommand}"
                  IsVisible="{Binding ShowOperationalPanels}">
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="nav-icon" Data="{StaticResource IconDownloads}" />
              <TextBlock Classes="nav-label"
                         Text="{DynamicResource NavDownloads}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel x:Name="SecondaryNavigation"
                    Grid.Row="3"
                    Spacing="10">
          <Button x:Name="SettingsNavButton"
                  Classes="nav"
                  Classes.active="{Binding IsSettingsOpen}"
                  AutomationProperties.Name="{DynamicResource NavSettings}"
                  ToolTip.Tip="{DynamicResource NavSettings}"
                  Command="{Binding ShowSettingsCommand}">
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="nav-icon" Data="{StaticResource IconSettings}" />
              <TextBlock Classes="nav-label" Text="{DynamicResource NavSettings}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Catalog import and export now live in Settings; the panel stays
             so the responsive layout keeps a slot for future shell actions. -->
        <StackPanel x:Name="SidebarFooter"
                     Grid.Row="4"
                     Spacing="4" />
      </Grid>
    </Border>

    <Border x:Name="MenuScrim"
            Grid.ColumnSpan="2"
            ZIndex="50"
            IsVisible="False"
            PointerPressed="MenuScrim_OnPointerPressed" />

    <Button x:Name="MenuButton"
            Grid.ColumnSpan="2"
            ZIndex="55"
            Classes="quiet"
            Margin="12"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsVisible="False"
            AutomationProperties.Name="{DynamicResource NavMenu}"
            ToolTip.Tip="{DynamicResource NavMenu}"
            Click="MenuButton_OnClick">
      <PathIcon Classes="nav-icon"
                Data="{StaticResource IconMenu}" />
    </Button>

    <Grid x:Name="MainContent"
          Grid.Column="1"
          RowDefinitions="*">
      <ScrollViewer x:Name="CatalogScroll"
                    Grid.Row="0"
                    IsVisible="{Binding IsCatalogOrSettingsOpen}">
        <StackPanel x:Name="CatalogBody"
                    Margin="30"
                    MaxWidth="1440"
                    Spacing="24">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                IsVisible="{Binding IsCatalogOpen}">
            <TextBlock Classes="title"
                       Text="{Binding SectionTitle}"
                       VerticalAlignment="Center" />
            <Button x:Name="CatalogToolsToggleButton"
                    Grid.Column="1"
                    Classes="quiet"
                    Content="{DynamicResource SearchAndFilters}"
                    Click="CatalogToolsToggleButton_OnClick"
                    IsVisible="False"
                    Margin="12,0"
                    VerticalAlignment="Center" />
            <!-- Rows are a preview of the library; the grid is the only view
                 that pages through all of it, so it stays one press away. -->
            <Button x:Name="CatalogViewToggleButton"
                    Grid.Column="2"
                    Classes="quiet"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Content="{Binding CatalogViewToggleText}"
                    Command="{Binding ToggleCatalogViewCommand}"
                    IsVisible="{Binding ShowCatalogViewToggle}" />
            <!-- The busy bar that used to sit here now spans the top of the
                 window, where it stays visible from anywhere on the page. -->
          </Grid>

          <!-- Visibility belongs to UpdateToolPanels: it combines
               ShowCatalogOverviewTools with the collapse state, and a binding here
               would overwrite the toggle the next time the property notified. -->
          <ContentControl Content="{Binding CatalogFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />
          <Border x:Name="CatalogSearchPanel"
                  Classes="surface"
                  Padding="14">
            <Grid x:Name="SearchGrid"
                  ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto">
              <TextBox x:Name="CatalogSearchTextBox"
                       Text="{Binding SearchQuery}"
                       AutomationProperties.Name="{DynamicResource CatalogSearchLabel}"
                       PlaceholderText="{DynamicResource CatalogSearchPlaceholder}"
                       MinHeight="44">
                <TextBox.InnerLeftContent>
                  <Path Width="16"
                        Height="16"
                        Margin="14,0,4,0"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        Fill="{StaticResource TextFaintBrush}"
                        Data="M9.5,3a6.5,6.5 0 1 0 4.03,11.6l4.43,4.44 1.41-1.41-4.43-4.44A6.5,6.5 0 0 0 9.5,3z M9.5,5a4.5,4.5 0 1 1 0,9 4.5,4.5 0 0 1 0-9z" />
                </TextBox.InnerLeftContent>
              </TextBox>
              <StackPanel x:Name="SearchActions"
                          Grid.Column="1"
                          Margin="10,0,0,0"
                          Orientation="Horizontal"
                          Spacing="8">
                <Button Classes="primary"
                        Content="{DynamicResource Search}"
                        Command="{Binding SearchCatalogCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        MinWidth="98"
                        MinHeight="44" />
                <!-- Criteria, not query text: a genre row opens a search with
                     an empty box, and binding this to the box left that search
                     with no visible way out. -->
                <Button Classes="quiet"
                        Content="{DynamicResource ClearSearch}"
                        Command="{Binding ClearSearchCommand}"
                        IsVisible="{Binding HasAnyCatalogSelection}"
                        IsEnabled="{Binding !IsBusy}"
                        MinHeight="44" />
              </StackPanel>
            </Grid>
          </Border>

          <Border x:Name="CatalogFilterPanel"
                  Classes="surface"
                  Padding="16">
            <WrapPanel Orientation="Horizontal"
                       VerticalAlignment="Center">
              <StackPanel Spacing="6"
                          Margin="0,0,12,10">
                <TextBlock Classes="field-label"
                           Text="{DynamicResource ProviderFilter}" />
                <ComboBox ItemsSource="{Binding ProviderFilters}"
                          SelectedItem="{Binding SelectedProviderFilter}"
                          AutomationProperties.Name="{DynamicResource ProviderFilter}"
                          MinWidth="230">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProviderFilterViewModel">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Spacing="6"
                          Margin="0,0,12,10">
                <TextBlock Classes="field-label"
                           Text="{DynamicResource CategoryFilter}" />
                <ComboBox ItemsSource="{Binding CategoryFilters}"
                          SelectedItem="{Binding SelectedCategoryFilter}"
                          AutomationProperties.Name="{DynamicResource CategoryFilter}"
                          MinWidth="190">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CatalogCategoryFilterViewModel">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Spacing="6"
                          Margin="0,0,12,10">
                <TextBlock Classes="field-label"
                           Text="{DynamicResource StatusFilter}" />
                <ComboBox ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          AutomationProperties.Name="{DynamicResource StatusFilter}"
                          MinWidth="150">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CatalogStatusFilterViewModel">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Spacing="6"
                          Margin="0,0,12,10">
                <TextBlock Classes="field-label"
                           Text="{DynamicResource GenreFilter}" />
                <ComboBox ItemsSource="{Binding GenreFilters}"
                          SelectedItem="{Binding SelectedGenreFilter}"
                          AutomationProperties.Name="{DynamicResource GenreFilter}"
                          MinWidth="190">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CatalogGenreFilterViewModel">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Spacing="6"
                          Margin="0,0,12,10">
                <TextBlock Classes="field-label"
                           Text="{DynamicResource YearFilter}" />
                <ComboBox ItemsSource="{Binding YearFilters}"
                          SelectedItem="{Binding SelectedYearFilter}"
                          AutomationProperties.Name="{DynamicResource YearFilter}"
                          MinWidth="130">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CatalogYearFilterViewModel">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Spacing="6"
                          Margin="0,0,12,10"
                          IsVisible="{Binding HasUserLists}">
                <TextBlock Classes="field-label"
                           Text="{DynamicResource ListFilter}" />
                <!-- No "all lists" row in the list itself: the entries are
                     real lists, and clearing the choice is what shows
                     everything. -->
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="6">
                  <ComboBox ItemsSource="{Binding UserLists}"
                            SelectedItem="{Binding SelectedCatalogListFilter}"
                            PlaceholderText="{DynamicResource AllLists}"
                            AutomationProperties.Name="{DynamicResource ListFilter}"
                            MinWidth="170"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:UserMediaListViewModel">
                        <TextBlock Text="{Binding DisplayLabel}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1"
                          Classes="quiet"
                          Content="&#xE711;"
                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                          FontSize="11"
                          Padding="8,0"
                          MinWidth="0"
                          ToolTip.Tip="{DynamicResource AllLists}"
                          AutomationProperties.Name="{DynamicResource AllLists}"
                          Command="{Binding ClearCatalogListFilterCommand}"
                          IsVisible="{Binding SelectedCatalogListFilter,
                                      Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Grid>
              </StackPanel>

              <Button Classes="quiet"
                      Content="{Binding FavoriteItemsFilterText}"
                      Command="{Binding ToggleFavoritesFilterCommand}"
                      IsEnabled="{Binding !IsBusy}"
                      MinHeight="44"
                      VerticalAlignment="Bottom"
                      Margin="0,0,10,10" />
            </WrapPanel>
          </Border>

          <Border Classes="surface"
                  Padding="22"
                  IsVisible="{Binding IsFriendsSection}">
            <StackPanel Spacing="18">
              <TextBlock Classes="body"
                         Text="{DynamicResource FriendsDescription}"
                         IsVisible="{Binding SupportsFriends}"
                         TextWrapping="Wrap" />
              <ContentControl Content="{Binding FriendsFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />

              <views:WatchPartyPanel IsVisible="{Binding SupportsWatchParties}" />

              <StackPanel Spacing="7"
                          IsVisible="{Binding SupportsFriends}">
                <TextBlock Classes="field-label"
                           Text="{DynamicResource FriendUsernameLabel}" />
                <WrapPanel>
                  <TextBox Width="280"
                           Margin="0,0,10,10"
                           MaxLength="64"
                           Text="{Binding FriendUsernameQuery}"
                           PlaceholderText="{DynamicResource FriendUsernamePlaceholder}"
                           AutomationProperties.Name="{DynamicResource FriendUsernameLabel}" />
                  <Button Classes="primary"
                          Margin="0,0,10,10"
                          MinHeight="44"
                          Content="{DynamicResource FriendAddAction}"
                          Command="{Binding AddFriendCommand}" />
                  <Button Classes="quiet"
                          Margin="0,0,0,10"
                          MinHeight="44"
                          Content="{DynamicResource FriendRefreshAction}"
                          Command="{Binding RefreshFriendsCommand}" />
                </WrapPanel>
              </StackPanel>

              <StackPanel Spacing="9"
                          IsVisible="{Binding HasFriendRequests}">
                <TextBlock Classes="subtitle"
                           Text="{DynamicResource FriendsRequestsTitle}" />
                <ItemsControl ItemsSource="{Binding FriendRequests}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FriendRequestViewModel">
                      <Border Classes="inner-card" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto">
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Classes="body"
                                       TextWrapping="Wrap"
                                       Text="{Binding DisplayName}" />
                            <TextBlock Classes="hint"
                                       TextWrapping="Wrap"
                                       Text="{Binding UsernameLabel}" />
                            <TextBlock Classes="hint"
                                       TextWrapping="Wrap"
                                       Text="{Binding StatusLabel}" />
                          </StackPanel>

                          <!-- Same treatment as a friend row, and the same
                               class, so both move below the name together on a
                               handset. Two buttons beside a name is the tighter
                               of the two cases. -->
                          <WrapPanel Classes="friend-actions"
                                     VerticalAlignment="Center">
                            <Button Classes="primary"
                                    Margin="8,0"
                                    MinHeight="40"
                                    IsVisible="{Binding CanAccept}"
                                    Content="{DynamicResource FriendRequestAcceptAction}"
                                    Command="{Binding AcceptCommand}" />
                            <Button Classes="quiet"
                                    MinHeight="40"
                                    Content="{Binding DismissLabel}"
                                    Command="{Binding DismissCommand}" />
                          </WrapPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="9"
                          IsVisible="{Binding HasFriends}">
                <TextBlock Classes="subtitle"
                           Text="{DynamicResource FriendsListTitle}" />
                <ItemsControl ItemsSource="{Binding Friends}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FriendViewModel">
                      <Border Classes="inner-card" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto,Auto">
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Classes="body"
                                       TextWrapping="Wrap"
                                       Text="{Binding DisplayName}" />
                            <TextBlock Classes="hint"
                                       TextWrapping="Wrap"
                                       Text="{Binding UsernameLabel}" />
                            <TextBlock Classes="hint"
                                       TextWrapping="Wrap"
                                       Text="{Binding FreshnessLabel}" />
                          </StackPanel>

                          <!-- Sharing and removal travel together, so a handset
                               can move both below the name in one step. A wrap
                               panel rather than a row: a longer translation of
                               either label drops the button to the next line
                               instead of pushing it off the card. -->
                          <WrapPanel Classes="friend-actions"
                                     VerticalAlignment="Center">
                            <CheckBox Margin="8,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding SharesProgress}"
                                      Content="{DynamicResource FriendSharesProgressLabel}"
                                      AutomationProperties.Name="{DynamicResource FriendSharesProgressLabel}" />
                            <Button Classes="quiet"
                                    MinHeight="40"
                                    VerticalAlignment="Center"
                                    Content="{DynamicResource FriendRemoveAction}"
                                    Command="{Binding RemoveCommand}" />
                          </WrapPanel>

                          <!-- Every comparison section lives in one
                               container, because the class that places it is
                               what assigns the grid cell: three siblings
                               wearing it would all claim the same cell and
                               paint over one another. -->
                          <StackPanel Classes="friend-shared"
                                      Margin="0,12,0,0"
                                      Spacing="12">

                            <!-- Titles in common. Absent rather than empty
                                 when there are none, so a new friend carries
                                 no dangling heading. -->
                            <StackPanel Spacing="4"
                                        IsVisible="{Binding HasSharedTitles}">
                              <TextBlock Classes="hint"
                                         Text="{Binding SharedTitlesLabel}" />

                              <!-- The same poster template the catalog uses,
                                   in the same horizontal shelf, so a title in
                                   common reads and opens like a title
                                   anywhere else rather than as a line of
                                   text. -->
                              <ScrollViewer
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                                <ItemsControl
                                    ItemsSource="{Binding SharedTitles}"
                                    ItemsPanel="{StaticResource CatalogRowPanel}"
                                    ItemTemplate="{StaticResource CatalogCardTemplate}" />
                              </ScrollViewer>
                            </StackPanel>

                            <!-- What they have and this account does not.
                                 Lines rather than posters: this device holds
                                 no copy, so there is nothing to open — the
                                 point is to name them, because these are the
                                 ones to go and find. Bounded in height so a
                                 well-read friend does not push everything
                                 below them off the page. -->
                            <StackPanel Spacing="4"
                                        IsVisible="{Binding HasTitlesOnlyTheirs}">
                              <TextBlock Classes="hint"
                                         Text="{Binding TitlesOnlyTheirsLabel}" />
                              <ScrollViewer MaxHeight="220"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding TitlesOnlyTheirs}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Grid ColumnDefinitions="Auto,*,Auto"
                                            Margin="0,2">
                                        <TextBlock Grid.Column="0"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding IsFavorite}"
                                                   Text="&#x2605;" />
                                        <!-- The name is the action: this
                                             device does not hold the title,
                                             so the one useful thing a click
                                             can do is go looking for it in
                                             the part of the catalog it
                                             belongs to. -->
                                        <Button Grid.Column="1"
                                                Classes="friend-title"
                                                Padding="0"
                                                HorizontalAlignment="Left"
                                                HorizontalContentAlignment="Left"
                                                VerticalAlignment="Center"
                                                Command="{Binding SearchCommand}"
                                                IsEnabled="{Binding CanSearch}"
                                                ToolTip.Tip="{DynamicResource FriendTitleSearchHint}"
                                                AutomationProperties.Name="{Binding Title}">
                                          <TextBlock TextTrimming="CharacterEllipsis"
                                                     Text="{Binding Title}" />
                                        </Button>
                                        <TextBlock Grid.Column="2"
                                                   Classes="hint"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Detail}" />
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </ScrollViewer>
                            </StackPanel>

                            <!-- What this account has and they do not: cards,
                                 because these are titles this device holds. -->
                            <StackPanel Spacing="4"
                                        IsVisible="{Binding HasTitlesOnlyMine}">
                              <TextBlock Classes="hint"
                                         Text="{Binding TitlesOnlyMineLabel}" />
                              <ScrollViewer
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                                <ItemsControl
                                    ItemsSource="{Binding TitlesOnlyMine}"
                                    ItemsPanel="{StaticResource CatalogRowPanel}"
                                    ItemTemplate="{StaticResource CatalogCardTemplate}" />
                              </ScrollViewer>
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <TextBlock Classes="hint"
                         TextWrapping="Wrap"
                         IsVisible="{Binding ShowNoFriends}"
                         Text="{DynamicResource FriendsNone}" />

              <Border Classes="inner-card"
                      Padding="16"
                      IsVisible="{Binding SupportsFriends}">
                <StackPanel Spacing="10">
                  <CheckBox IsChecked="{Binding ShareProgressWithFriends}"
                            Content="{DynamicResource FriendsShareProgressLabel}" />
                  <CheckBox IsChecked="{Binding DiscoverableByUsername}"
                            Content="{DynamicResource FriendsDiscoverableLabel}" />
                  <Button Classes="quiet"
                          HorizontalAlignment="Left"
                          MinHeight="44"
                          Content="{DynamicResource FriendsSaveVisibility}"
                          Command="{Binding SaveFriendVisibilityCommand}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="surface"
                  Padding="22"
                  IsVisible="{Binding IsUserListsSection}">
            <StackPanel Spacing="18">
              <ContentControl Content="{Binding ListsFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />
              <TextBlock Classes="body"
                         Text="{DynamicResource UserListsDescription}"
                         TextWrapping="Wrap" />

              <StackPanel Spacing="7">
                <TextBlock Classes="field-label"
                           Text="{DynamicResource NewUserListName}" />
                <TextBox Text="{Binding NewUserListName}"
                         MaxLength="80"
                         AutomationProperties.Name="{DynamicResource NewUserListName}"
                         PlaceholderText="{DynamicResource NewUserListPlaceholder}" />
                <Button Classes="primary"
                        Content="{DynamicResource CreateUserList}"
                        Command="{Binding CreateUserListCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        HorizontalAlignment="Left" />
              </StackPanel>

              <TextBlock Classes="body"
                         Text="{DynamicResource NoUserLists}"
                         IsVisible="{Binding ShowNoUserLists}"
                         TextWrapping="Wrap" />

              <StackPanel Spacing="10"
                          IsVisible="{Binding HasUserLists}">
                <Border Height="1"
                        Background="{StaticResource DividerBrush}"
                        Margin="0,2" />
                <!-- Filtering the open list: which list, and whether to show
                     only the titles starred in the catalog. The provider
                     picker is deliberately absent — a list is a hand-picked
                     set, so where each title came from is not how you narrow
                     it. -->
                <CheckBox Content="{DynamicResource ListFavoritesOnly}"
                          IsChecked="{Binding ShowFavoriteTitlesOnly}"
                          IsEnabled="{Binding !IsBusy}" />

                <!-- Picker, name and both actions on one line. Stacked, this
                     was five full-width rows and a label to manage a list of
                     one field. -->
                <Grid ColumnDefinitions="*,*,Auto,Auto"
                      ColumnSpacing="8">
                  <ComboBox ItemsSource="{Binding UserLists}"
                            SelectedItem="{Binding SelectedUserList}"
                            AutomationProperties.Name="{DynamicResource SelectUserList}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:UserMediaListViewModel">
                        <TextBlock Text="{Binding DisplayLabel}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox Grid.Column="1"
                           Text="{Binding RenameUserListName}"
                           MaxLength="80"
                           VerticalAlignment="Center"
                           PlaceholderText="{DynamicResource NewUserListName}"
                           AutomationProperties.Name="{DynamicResource NewUserListName}" />
                  <Button Grid.Column="2"
                          Content="{DynamicResource RenameUserList}"
                          Command="{Binding RenameUserListCommand}"
                          IsEnabled="{Binding !IsBusy}"
                          VerticalAlignment="Center" />
                  <Button Grid.Column="3"
                          Classes="quiet danger"
                          Content="{DynamicResource DeleteUserList}"
                          Command="{Binding RequestDeleteUserListCommand}"
                          IsVisible="{Binding !IsDeleteUserListConfirmationVisible}"
                          IsEnabled="{Binding !IsBusy}"
                          VerticalAlignment="Center" />
                </Grid>

                <Border Classes="notice danger"
                        Padding="12"
                        IsVisible="{Binding IsDeleteUserListConfirmationVisible}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="{DynamicResource ConfirmDeleteUserList}"
                               Foreground="{StaticResource DangerTextBrush}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal">
                      <Button Classes="danger"
                              Content="{DynamicResource ConfirmDelete}"
                              Command="{Binding ConfirmDeleteUserListCommand}"
                              IsEnabled="{Binding !IsBusy}"
                              Margin="0,0,8,0" />
                      <Button Classes="quiet"
                              Content="{DynamicResource Cancel}"
                              Command="{Binding CancelDeleteUserListCommand}"
                              IsEnabled="{Binding !IsBusy}" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <Border Classes="inner-card"
                        Padding="14"
                        IsVisible="{Binding IsRemoteSignedIn}">
                  <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                      <StackPanel Spacing="2"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource RemoteShareList}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold" />
                        <TextBlock Classes="hint"
                                   Text="{DynamicResource RemoteShareListDescription}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Content="{DynamicResource RemotePublishList}"
                              Command="{Binding PublishSelectedUserListCommand}"
                              IsEnabled="{Binding CanPublishSelectedUserList}"
                              VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Spacing="7"
                                IsVisible="{Binding HasRemoteSharedListUrl}">
                      <TextBlock Classes="field-label"
                                 Text="{DynamicResource RemoteSharedCatalogUrl}" />
                      <TextBox Text="{Binding RemoteSharedListUrl}"
                               IsReadOnly="True"
                               AutomationProperties.Name="{DynamicResource RemoteSharedCatalogUrl}" />
                      <Button Classes="quiet danger"
                              Content="{DynamicResource RemoteRevokeShare}"
                              Command="{Binding RevokeLastSharedListCommand}"
                              IsEnabled="{Binding CanUseRemoteSync}"
                              HorizontalAlignment="Left" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="notice"
                  IsVisible="{Binding IsTelevision}">
            <TextBlock Classes="body"
                       Text="{DynamicResource TvNavigationHint}"
                       Foreground="{StaticResource AccentTextBrush}"
                       TextWrapping="Wrap" />
          </Border>

          <Border Classes="inner-card"
                  Padding="30"
                  IsVisible="{Binding ShowEmptyUserList}">
            <StackPanel Spacing="10"
                        HorizontalAlignment="Center">
              <TextBlock Text="≡"
                         Foreground="{StaticResource TextFaintBrush}"
                         FontSize="34"
                         HorizontalAlignment="Center" />
              <TextBlock Text="{DynamicResource EmptyUserList}"
                         Foreground="{StaticResource TextMutedBrush}"
                         FontSize="{StaticResource FontSizeBodyLarge}"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         MaxWidth="460" />
            </StackPanel>
          </Border>

          <!-- Home shelves: last seen, then one shelf per kind. -->
          <ItemsControl x:Name="HomeSectionsControl"
                        ItemsSource="{Binding HomeSections}"
                        IsVisible="{Binding ShowHomeSections}"
                        ItemTemplate="{StaticResource CatalogShelfTemplate}" />

          <!-- The same rows on movies, anime and books: what arrived, what
               changed, then the genres this library actually holds. -->
          <ItemsControl x:Name="BrowseShelvesControl"
                        ItemsSource="{Binding BrowseShelves}"
                        IsVisible="{Binding ShowBrowseShelves}"
                        ItemTemplate="{StaticResource CatalogShelfTemplate}" />

          <!-- The TV shelf points at the Live TV page: channels come from
               providers at open time, not from the catalog. -->
          <Border Classes="surface"
                  Padding="20"
                  Margin="0,0,0,26"
                  IsVisible="{Binding ShowHomeSections}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Classes="title"
                           Text="{DynamicResource NavLiveTv}" />
                <TextBlock Classes="hint"
                           Text="{DynamicResource HomeLiveTvPrompt}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button x:Name="HomeLiveTvButton"
                      Grid.Column="1"
                      Classes="primary"
                      Margin="14,0,0,0"
                      VerticalAlignment="Center"
                      Content="{DynamicResource NavLiveTv}"
                      Command="{Binding ShowLiveTvCommand}" />
            </Grid>
          </Border>

          <ItemsControl Classes="catalog-grid"
                        ItemsSource="{Binding Items}"
                        IsVisible="{Binding ShowFlatCatalogList}"
                        ItemTemplate="{StaticResource CatalogCardTemplate}" />
          <Border Classes="surface"
                  Padding="14"
                  IsVisible="{Binding ShowCatalogPagination}">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14">
              <Button x:Name="CatalogPreviousPageButton"
                      Classes="quiet"
                      Content="{DynamicResource Previous}"
                      Command="{Binding PreviousCatalogPageCommand}" />
              <TextBlock Grid.Column="1"
                         Classes="body"
                         Text="{Binding CatalogPageSummary}"
                         TextAlignment="Center"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              <Button x:Name="CatalogNextPageButton"
                      Grid.Column="2"
                      Classes="quiet"
                      Content="{DynamicResource Next}"
                      Command="{Binding NextCatalogPageCommand}" />
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid x:Name="LiveTvPage"
            Grid.Row="0"
            Margin="30"
            MaxWidth="1440"
            HorizontalAlignment="Stretch"
            RowDefinitions="Auto,Auto,Auto,*"
            RowSpacing="18"
            IsVisible="{Binding IsLiveTvPageVisible}">
        <Grid x:Name="LiveTvHeaderGrid"
              ColumnDefinitions="*,Auto">
          <StackPanel Spacing="5">
            <TextBlock Classes="display"
                       Text="{DynamicResource LiveTvTitle}" />
            <TextBlock Classes="body"
                       x:Name="LiveTvDescriptionText"
                       Text="{DynamicResource LiveTvDescription}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <!-- One panel, so a narrow layout can move both buttons under the
               title in a single step instead of tracking two grid cells. -->
          <StackPanel x:Name="LiveTvHeaderActions"
                      Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="10"
                      VerticalAlignment="Center"
                      Margin="16,0,0,0">
            <Button x:Name="LiveTvToolsToggleButton"
                    Classes="quiet"
                    Content="{DynamicResource SearchAndFilters}"
                    Click="LiveTvToolsToggleButton_OnClick"
                    IsVisible="False" />
            <Button x:Name="LiveTvRefreshButton"
                    Classes="primary"
                    Content="{DynamicResource LiveTvRefresh}"
                    Command="{Binding RefreshLiveTvCommand}"
                    IsEnabled="{Binding !IsBusy}" />
          </StackPanel>
        </Grid>

        <Border x:Name="LiveTvFiltersPanel"
                Grid.Row="1"
                Classes="surface"
                Padding="16">
          <WrapPanel Orientation="Horizontal">
            <StackPanel Classes="live-tv-search-container"
                        Margin="0,0,12,10"
                        Spacing="6">
              <TextBlock Classes="field-label"
                         Text="{DynamicResource LiveTvSearchLabel}" />
              <TextBox x:Name="LiveTvSearchTextBox"
                       Classes="live-tv-search"
                       Text="{Binding LiveTvSearchQuery}"
                       PlaceholderText="{DynamicResource LiveTvSearchPlaceholder}"
                       AutomationProperties.Name="{DynamicResource LiveTvSearchLabel}"
                       MinHeight="44" />
            </StackPanel>
            <StackPanel Classes="live-tv-filter-field"
                        Margin="0,0,12,10"
                        Spacing="6">
              <TextBlock Classes="field-label"
                         Text="{DynamicResource LiveTvProviderLabel}" />
              <ComboBox x:Name="LiveTvProviderComboBox"
                        ItemsSource="{Binding LiveTvProviderFilters}"
                        SelectedItem="{Binding SelectedLiveTvProviderFilter}"
                        AutomationProperties.Name="{DynamicResource LiveTvProviderLabel}"
                        MinHeight="44">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LiveTvFilterOptionViewModel">
                    <TextBlock Text="{Binding DisplayName}"
                               TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Classes="live-tv-filter-field"
                        Margin="0,0,0,10"
                        Spacing="6">
              <TextBlock Classes="field-label"
                         Text="{DynamicResource LiveTvGroupLabel}" />
              <ComboBox x:Name="LiveTvGroupComboBox"
                        ItemsSource="{Binding LiveTvGroupFilters}"
                        SelectedItem="{Binding SelectedLiveTvGroupFilter}"
                        AutomationProperties.Name="{DynamicResource LiveTvGroupLabel}"
                        MinHeight="44">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LiveTvFilterOptionViewModel">
                    <TextBlock Text="{Binding DisplayName}"
                               TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </WrapPanel>
        </Border>

        <Grid x:Name="LiveTvStatusGrid"
              Grid.Row="2"
              ColumnDefinitions="*,Auto">
          <StackPanel x:Name="LiveTvNoticeStack"
                      Margin="0,0,16,0"
                      Spacing="10">
            <ContentControl Content="{Binding LiveTvFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />
            <Border Classes="notice warning"
                    IsVisible="{Binding HasLiveTvFailures}">
              <TextBlock Text="{Binding LiveTvFailureSummary}"
                         Foreground="{StaticResource AmberBrush}"
                         TextWrapping="Wrap" />
            </Border>
          </StackPanel>
          <TextBlock x:Name="LiveTvChannelSummaryText"
                     Grid.Column="1"
                     Classes="hint"
                     Text="{Binding LiveTvChannelSummary}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="3">
          <ListBox x:Name="LiveTvChannelList"
                   ItemsSource="{Binding LiveTvChannels}"
                   SelectedItem="{Binding SelectedLiveTvChannel}"
                   Focusable="True"
                   Background="Transparent"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   IsVisible="{Binding HasLiveTvChannels}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LiveTvChannelViewModel">
                <Button Classes="live-tv-channel"
                        Command="{Binding PlayCommand}"
                        AutomationProperties.Name="{Binding Name}">
                  <Border Classes="surface live-tv-row"
                          Padding="12"
                          MinHeight="88">
                    <!-- Auto, not a fixed 120: the thumbnail shrinks on a handset and
                         the column follows it, giving the name the room instead. -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="16">
                      <Grid Classes="live-tv-thumb"
                            IsVisible="{Binding HasArtwork}">
                        <views:CatalogArtworkView
                            DataContext="{Binding Artwork}" />
                      </Grid>
                      <Border Classes="live-tv-thumb"
                              Background="{StaticResource SurfaceRaisedBrush}"
                              BorderBrush="{StaticResource BorderSubtleBrush}"
                              BorderThickness="1"
                              CornerRadius="{StaticResource RadiusMd}"
                              IsVisible="{Binding !HasArtwork}">
                        <PathIcon Width="28"
                                  Height="28"
                                  Data="{StaticResource IconLiveTv}"
                                  Foreground="{StaticResource TextFaintBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1"
                                  Spacing="7"
                                  VerticalAlignment="Center">
                        <TextBlock Classes="title"
                                   Text="{Binding Name}"
                                   FontSize="18"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="hint"
                                   Text="{Binding MetadataText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Border Grid.Column="2"
                              Classes="chip live-tv-action"
                              Background="{StaticResource MintSoftBrush}"
                              VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="7">
                          <TextBlock Text="▶"
                                     Foreground="{StaticResource MintBrush}" />
                          <TextBlock Text="{DynamicResource LiveTvWatch}"
                                     Foreground="{StaticResource MintBrush}"
                                     FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Classes="surface"
                  Padding="30"
                  IsVisible="{Binding ShowNoLiveTvChannels}"
                  VerticalAlignment="Top">
            <StackPanel Spacing="9"
                        HorizontalAlignment="Center">
              <PathIcon Width="38"
                        Height="38"
                        Data="{StaticResource IconLiveTv}"
                        Foreground="{StaticResource TextFaintBrush}" />
              <TextBlock Classes="title"
                         Text="{DynamicResource LiveTvNoChannels}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
              <TextBlock Classes="hint"
                         Text="{DynamicResource LiveTvNoChannelsHint}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <ScrollViewer Grid.Row="0"
                    IsVisible="{Binding IsDownloadsOpen}">
        <StackPanel Margin="30"
                    MaxWidth="1440"
                    Spacing="20">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
              <TextBlock Classes="display"
                         Text="{DynamicResource DownloadsTitle}" />
              <TextBlock Classes="body"
                         Text="{DynamicResource DownloadsDescription}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{DynamicResource RefreshDownloads}"
                    Command="{Binding ShowDownloadsCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    VerticalAlignment="Center" />
          </Grid>

          <Grid ColumnDefinitions="*,*,*"
                ColumnSpacing="12">
            <Border Classes="stat">
              <StackPanel>
                <!-- These three tiles share a phone width between them, so the
                     labels have to wrap rather than lose their tail: a clipped
                     "SAVED ITEN" reads as a different word. -->
                <TextBlock Classes="eyebrow"
                           Text="{DynamicResource DownloadsTotalLabel}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding DownloadCount}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="27"
                           FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Classes="stat">
              <StackPanel>
                <TextBlock Classes="eyebrow"
                           Text="{DynamicResource DownloadsActiveLabel}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding ActiveDownloadCount}"
                           Foreground="{StaticResource MintBrush}"
                           FontSize="27"
                           FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Classes="stat">
              <StackPanel>
                <TextBlock Classes="eyebrow"
                           Text="{DynamicResource DownloadsStorageLabel}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding DownloadStorageSummary}"
                           Foreground="{StaticResource AccentTextBrush}"
                           FontSize="17"
                           FontWeight="Bold"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Classes="surface"
                  Padding="16">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3"
                          VerticalAlignment="Center">
                <TextBlock Text="{Binding DownloadSelectionSummary}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontWeight="SemiBold" />
                <TextBlock Classes="hint"
                           Text="{DynamicResource DownloadsDeleteHint}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <WrapPanel Grid.Column="1"
                         Orientation="Horizontal"
                         HorizontalAlignment="Right">
                <Button Classes="quiet"
                        Content="{DynamicResource SelectAllDownloads}"
                        Command="{Binding ToggleSelectAllDownloadsCommand}"
                        IsEnabled="{Binding HasDownloads}"
                        Margin="8,0,0,0" />
                <Button Classes="danger"
                        Content="{DynamicResource DeleteSelectedDownloads}"
                        Command="{Binding RequestDeleteSelectedDownloadsCommand}"
                        IsVisible="{Binding HasSelectedDownloads}"
                        Margin="8,0,0,0" />
                <Button Classes="quiet danger"
                        Content="{DynamicResource DeleteAllDownloads}"
                        Command="{Binding RequestDeleteAllDownloadsCommand}"
                        IsEnabled="{Binding HasDownloads}"
                        Margin="8,0,0,0" />
              </WrapPanel>
            </Grid>
          </Border>

          <Border Classes="notice danger"
                  IsVisible="{Binding IsDownloadDeleteConfirmationVisible}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding DownloadDeleteConfirmationText}"
                           Foreground="{StaticResource DangerTextBrush}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource DownloadsDeletePermanent}"
                           Foreground="{StaticResource DangerMutedTextBrush}"
                           FontSize="{StaticResource FontSizeCaption}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <WrapPanel Grid.Column="1"
                         Orientation="Horizontal"
                         VerticalAlignment="Center"
                         Margin="12,0,0,0">
                <Button Classes="danger"
                        Content="{DynamicResource DeleteDownloadsNow}"
                        Command="{Binding ConfirmDeleteDownloadsCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Margin="0,0,8,0" />
                <Button Classes="quiet"
                        Content="{DynamicResource Cancel}"
                        Command="{Binding CancelDeleteDownloadsCommand}"
                        IsEnabled="{Binding !IsBusy}" />
              </WrapPanel>
            </Grid>
          </Border>

          <ContentControl Content="{Binding DownloadsFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />

          <Border Classes="surface"
                  Padding="40,44"
                  IsVisible="{Binding !HasDownloads}">
            <StackPanel HorizontalAlignment="Center"
                        Spacing="14">
              <Border Width="66"
                      Height="66"
                      CornerRadius="999"
                      Background="{StaticResource AccentSoftBrush}"
                      HorizontalAlignment="Center">
                <TextBlock Text="⇩"
                           Foreground="{StaticResource AccentTextBrush}"
                           FontSize="30"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <TextBlock Classes="subtitle"
                         Text="{DynamicResource DownloadsEmptyTitle}"
                         HorizontalAlignment="Center" />
              <TextBlock Classes="body"
                         Text="{DynamicResource DownloadsEmptyDescription}"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         MaxWidth="520" />
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Downloads}"
                        IsVisible="{Binding HasDownloads}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TorrentDownloadItemViewModel">
                <Border Classes="download-card">
                  <Grid ColumnDefinitions="Auto,*"
                        ColumnSpacing="14">
                    <CheckBox IsChecked="{Binding IsSelected}"
                              VerticalAlignment="Top"
                              Margin="0,3,0,0"
                              AutomationProperties.Name="{Binding Title}" />
                    <StackPanel Grid.Column="1"
                                Spacing="10">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding Title}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="hint"
                                     Text="{Binding Detail}"
                                     IsVisible="{Binding HasDetail}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Classes="chip"
                                Grid.Column="1"
                                Padding="10,5"
                                VerticalAlignment="Top">
                          <TextBlock Text="{Binding StateText}"
                                     Foreground="{StaticResource AccentTextBrush}"
                                     FontSize="{StaticResource FontSizeMicro}"
                                     FontWeight="Bold" />
                        </Border>
                      </Grid>

                      <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding ProgressText}"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     FontSize="{StaticResource FontSizeCaption}" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding StoredSizeText}"
                                     Foreground="{StaticResource MintBrush}"
                                     FontSize="{StaticResource FontSizeCaption}" />
                        </Grid>
                        <ProgressBar Height="7"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ProgressPercent}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}" />
                      </StackPanel>

                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                        <TextBlock Classes="micro"
                                   Text="{Binding UpdatedText}"
                                   VerticalAlignment="Center" />
                        <WrapPanel Grid.Column="1"
                                   Orientation="Horizontal">
                          <Button Classes="quiet"
                                  Content="{DynamicResource PauseTorrent}"
                                  Command="{Binding PauseCommand}"
                                  IsVisible="{Binding CanPause}"
                                  Margin="0,0,7,0" />
                          <Button Classes="quiet"
                                  Content="{DynamicResource ResumeTorrent}"
                                  Command="{Binding ResumeCommand}"
                                  IsVisible="{Binding CanResume}"
                                  Margin="0,0,7,0" />
                          <Button Classes="quiet danger"
                                  Content="{DynamicResource DeleteDownload}"
                                  Command="{Binding RequestDeleteCommand}" />
                        </WrapPanel>
                      </Grid>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="DetailsScroll"
                    Grid.Row="0"
                    IsVisible="{Binding IsDetailsOpen}">
        <StackPanel Margin="30"
                    MaxWidth="1440"
                    Spacing="20">
          <Grid ColumnDefinitions="Auto,*">
            <Button x:Name="DetailsBackButton"
                    Classes="quiet"
                    Command="{Binding CloseDetailsCommand}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{DynamicResource BackToCatalog}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="←"
                           FontSize="15"
                           VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource BackToCatalog}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <ProgressBar Grid.Column="1"
                         Width="110"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="{DynamicResource BusyLabel}"
                         IsIndeterminate="{Binding IsBusy}"
                         IsVisible="{Binding IsBusy}" />
          </Grid>

          <Border Classes="surface hero"
                  Padding="26"
                  ClipToBounds="True">
            <Border.Background>
              <SolidColorBrush Color="#131722" />
            </Border.Background>
            <Grid>
              <!-- Canvas excludes the decorative image from desired-size measurement.
                   Its bounds follow the header content, with artwork capped at 480 DIP.
                   Wide art behind the header, gated on its own wrapper rather
                   than on the element that carries the DataContext: a binding
                   set beside DataContext resolves against the new context and
                   would silently fall back to visible. -->
              <Canvas x:Name="DetailsBackdropHost"
                      IsVisible="{Binding SelectedDetails.HasBackdrop}"
                      IsHitTestVisible="False"
                      ClipToBounds="True">
                <views:CatalogArtworkView
                    Width="{Binding #DetailsBackdropHost.Bounds.Width}"
                    Height="{Binding #DetailsBackdropHost.Bounds.Height}"
                    MaxHeight="480"
                    DataContext="{Binding SelectedDetails.Backdrop}" />
              </Canvas>
              <!-- Every scrim stop is an alpha of the page's own backdrop
                   colour, so artwork dissolves into the page instead of into a
                   tinted haze, and the text below stays legible over anything. -->
              <Border IsVisible="{Binding SelectedDetails.HasBackdrop}"
                      IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#E6131722" Offset="0" />
                    <GradientStop Color="#C2131722" Offset="0.45" />
                    <GradientStop Color="#F7131722" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>

            <Grid x:Name="DetailsHeroGrid"
                  ColumnDefinitions="Auto,*"
                  RowDefinitions="Auto">
              <StackPanel x:Name="DetailsArtworkContainer"
                          Margin="0,0,24,0"
                          Spacing="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top">
                <Border IsVisible="{Binding SelectedDetails.HasArtwork}">
                  <views:CatalogArtworkView x:Name="DetailsArtwork"
                                             Width="176"
                                             Height="248"
                                             VerticalAlignment="Top"
                                             DataContext="{Binding SelectedDetails.Artwork}" />
                </Border>
                <Button Classes="quiet"
                        Command="{Binding ToggleSelectedItemFavoriteCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        HorizontalAlignment="Stretch">
                  <StackPanel Orientation="Horizontal"
                              HorizontalAlignment="Center"
                              Spacing="8">
                    <TextBlock Text="{Binding SelectedItemFavoriteGlyph}"
                               Foreground="{StaticResource AmberBrush}" />
                    <TextBlock Text="{Binding SelectedItemFavoriteActionText}" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <StackPanel x:Name="DetailsHeroContent"
                          Grid.Column="1"
                          Spacing="12"
                          VerticalAlignment="Top">
                <WrapPanel>
                  <Border Classes="chip"
                          Padding="10,5"
                          Margin="0,0,8,6">
                    <TextBlock Text="{Binding SelectedDetails.Subtype}"
                               Foreground="{StaticResource AccentTextBrush}"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="Bold" />
                  </Border>
                  <Border Classes="chip outline"
                          IsVisible="{Binding SelectedDetails.HasStatus}"
                          Padding="10,5"
                          Margin="0,0,8,6">
                    <TextBlock Text="{Binding SelectedDetails.StatusText}"
                               Foreground="{StaticResource AmberBrush}"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="Bold" />
                  </Border>
                  <TextBlock Text="{Binding SelectedDetails.GenreText}"
                             Foreground="{StaticResource MintBrush}"
                             FontSize="{StaticResource FontSizeCaption}"
                             VerticalAlignment="Center"
                             Margin="0,0,10,6" />
                  <TextBlock Text="{Binding SelectedDetails.CategoryText}"
                             IsVisible="{Binding SelectedDetails.HasCategories}"
                             Foreground="{StaticResource AmberBrush}"
                             FontSize="{StaticResource FontSizeCaption}"
                             VerticalAlignment="Center"
                             Margin="0,0,10,6" />
                  <Border Classes="chip mint"
                          Padding="10,5"
                          Margin="0,0,0,6">
                    <TextBlock Text="{Binding SelectedDetails.OriginBadge}"
                               Foreground="{StaticResource MintBrush}"
                               FontSize="{StaticResource FontSizeMicro}"
                               FontWeight="Bold" />
                  </Border>
                </WrapPanel>
                <TextBlock Classes="display"
                           Text="{Binding SelectedDetails.Name}"
                           TextWrapping="Wrap" />
                <Button x:Name="DetailsContinueButton"
                        Classes="primary"
                        Content="{Binding SelectedDetails.ContinueActionText}"
                        Command="{Binding SelectedDetails.ContinueCommand}"
                        IsVisible="{Binding SelectedDetails.CanContinue}"
                        IsEnabled="{Binding !IsBusy}"
                        HorizontalAlignment="Left" />
                <ItemsControl ItemsSource="{Binding SelectedDetails.AlternativeNames}"
                              IsVisible="{Binding SelectedDetails.HasAlternativeNames}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CatalogAlternativeNameViewModel">
                      <Border Classes="chip outline"
                              Margin="0,0,8,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding Name}"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     FontSize="{StaticResource FontSizeCaption}"
                                     MaxWidth="420"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Name}" />
                          <TextBlock Text="{Binding Language}"
                                     Foreground="{StaticResource AccentTextBrush}"
                                     FontSize="{StaticResource FontSizeMicro}" />
                          <TextBlock Classes="micro"
                                     Text="{Binding Kind}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel IsVisible="{Binding SelectedDetails.HasContributors}"
                            Spacing="6">
                  <TextBlock Classes="field-label"
                             Text="{DynamicResource ContributorsTitle}" />
                  <ItemsControl ItemsSource="{Binding SelectedDetails.Contributors}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CatalogContributorViewModel">
                        <Border Classes="chip outline"
                                Padding="12,8"
                                Margin="0,0,8,6">
                          <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Name}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         FontSize="{StaticResource FontSizeCaption}"
                                         FontWeight="SemiBold" />
                              <TextBlock Classes="micro"
                                         Text="{Binding Kind}" />
                            </StackPanel>
                            <TextBlock Text="{Binding CreditText}"
                                       IsVisible="{Binding HasCredits}"
                                       Foreground="{StaticResource MintBrush}"
                                       FontSize="{StaticResource FontSizeMicro}" />
                            <TextBlock Text="{Binding Url}"
                                       IsVisible="{Binding HasUrl}"
                                       Foreground="{StaticResource AccentTextBrush}"
                                       FontSize="{StaticResource FontSizeMicro}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="360"
                                       ToolTip.Tip="{Binding Url}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <TextBlock Classes="hint"
                           Text="{Binding SelectedDetails.Metadata}" />
                <TextBlock Text="{Binding SelectedDetails.Description}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           LineHeight="21"
                           TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal">
                  <Button Content="{Binding SelectedDetails.MetadataRefreshButtonText}"
                          Command="{Binding RefreshMetadataCommand}"
                          IsVisible="{Binding SelectedDetails.CanRefreshMetadata}"
                          IsEnabled="{Binding !IsBusy}"
                          Margin="0,0,8,0" />
                  <Button Classes="quiet danger"
                          Content="{DynamicResource DeleteCatalogItem}"
                          Command="{Binding RequestDeleteCatalogItemCommand}"
                          IsVisible="{Binding !IsCatalogItemDeleteConfirmationVisible}"
                          IsEnabled="{Binding !IsBusy}" />
                </WrapPanel>
                <Border Classes="notice danger"
                        Padding="12"
                        IsVisible="{Binding IsCatalogItemDeleteConfirmationVisible}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="{DynamicResource ConfirmDeleteCatalogItem}"
                               Foreground="{StaticResource DangerTextBrush}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal">
                      <Button Classes="danger"
                              Content="{DynamicResource ConfirmDelete}"
                              Command="{Binding ConfirmDeleteCatalogItemCommand}"
                              IsEnabled="{Binding !IsBusy}"
                              Margin="0,0,8,0" />
                      <Button Classes="quiet"
                              Content="{DynamicResource Cancel}"
                              Command="{Binding CancelDeleteCatalogItemCommand}"
                              IsEnabled="{Binding !IsBusy}" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border x:Name="DetailsListMembershipPanel"
                        Classes="inner-card"
                        Padding="14">
                  <StackPanel Spacing="9">
                    <TextBlock Text="{DynamicResource ListMembershipTitle}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="SemiBold" />
                    <!-- The lists this title is already on, each removable in
                         place. The picker below is for putting it on a new
                         one; taking it off should not require finding the
                         right list first. Inside DetailsListMembershipPanel,
                         so the television scope hides all of it. -->
                    <ItemsControl ItemsSource="{Binding SelectedItemUserLists}"
                                  IsVisible="{Binding HasSelectedItemUserLists}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:UserMediaListViewModel">
                          <Border Classes="chip"
                                  Padding="10,5"
                                  Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                              <TextBlock Text="{Binding Name}"
                                         VerticalAlignment="Center" />
                              <Button Classes="quiet danger"
                                      Content="&#xE711;"
                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                      FontSize="11"
                                      Padding="6,2"
                                      MinWidth="0"
                                      ToolTip.Tip="{DynamicResource RemoveFromList}"
                                      AutomationProperties.Name="{DynamicResource RemoveFromList}"
                                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveSelectedItemFromListCommand}"
                                      CommandParameter="{Binding}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8"
                          IsVisible="{Binding HasUserLists}">
                      <ComboBox ItemsSource="{Binding UserLists}"
                                SelectedItem="{Binding SelectedDetailUserList}"
                                AutomationProperties.Name="{DynamicResource SelectUserList}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:UserMediaListViewModel">
                            <TextBlock Text="{Binding DisplayLabel}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <!-- Reads and styles as a removal once the title is in
                           the chosen list, so taking it out is a visible
                           action rather than the same button meaning the
                           opposite thing. -->
                      <Button Grid.Column="1"
                              Classes.danger="{Binding SelectedItemIsInDetailUserList}"
                              Content="{Binding SelectedItemUserListActionText}"
                              Command="{Binding ToggleSelectedItemUserListCommand}"
                              IsVisible="{Binding HasDetailUserListTarget}"
                              IsEnabled="{Binding !IsBusy}"
                              VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Spacing="8"
                                IsVisible="{Binding !HasUserLists}">
                      <TextBlock Classes="hint"
                                 Text="{DynamicResource NoListsForItem}"
                                 TextWrapping="Wrap" />
                      <Button Content="{DynamicResource OpenUserLists}"
                              Command="{Binding OpenUserListsFromDetailsCommand}"
                              IsEnabled="{Binding !IsBusy}"
                              HorizontalAlignment="Left" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
            </Grid>
          </Border>

          <!-- Absent unless a friend has actually reached something in this
               title, so a page with nothing to say carries no empty heading.
               Filled after the page is shown, since a slow or missing server
               must not hold up the title itself. -->
          <Border Classes="surface"
                  Padding="18"
                  IsVisible="{Binding ShowDetailFriendProgress}">
            <StackPanel Spacing="9">
              <TextBlock Classes="subtitle"
                         Text="{DynamicResource FriendProgressTitle}" />
              <ItemsControl ItemsSource="{Binding DetailFriendProgress}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FriendProgressViewModel">
                    <TextBlock Classes="body"
                               Margin="0,0,0,4"
                               TextWrapping="Wrap"
                               Text="{Binding Summary}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <ContentControl Content="{Binding DetailsFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />

          <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                ColumnSpacing="10">
            <TextBlock Classes="title"
                       Text="{DynamicResource EntriesTitle}" />
            <Button Grid.Column="1"
                    Classes="quiet"
                    Content="{Binding SelectedDetails.EntryOrderActionText}"
                    Command="{Binding SelectedDetails.ToggleEntryOrderCommand}"
                    IsVisible="{Binding SelectedDetails.HasEntries}"
                    AutomationProperties.Name="{Binding SelectedDetails.EntryOrderActionText}"
                    VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Classes="quiet"
                    Content="{Binding SelectedDetails.ToggleAllSeenText}"
                    Command="{Binding SelectedDetails.ToggleAllSeenCommand}"
                    IsVisible="{Binding SelectedDetails.CanToggleAllSeen}"
                    IsEnabled="{Binding !IsBusy}"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Column="3"
                       Text="{DynamicResource PlaybackAvailable}"
                       IsVisible="{Binding IsMediaPlaybackAvailable}"
                       Foreground="{StaticResource MintBrush}"
                       FontSize="{StaticResource FontSizeCaption}"
                       VerticalAlignment="Center" />
          </Grid>

          <TextBlock Classes="body"
                     Text="{Binding SelectedDetails.EmptyMessage}"
                     IsVisible="{Binding !SelectedDetails.HasEntries}" />

          <!-- Only for a title that actually has more than one season; with a
               single one the divider above its episodes already names it.
               Buttons rather than a drop-down: the popup opened without taking
               focus on a television, leaving the remote driving the page
               behind it. -->
          <StackPanel Spacing="8"
                      IsVisible="{Binding SelectedDetails.HasSeasonSelector}">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource SeasonSelectorLabel}" />
            <ItemsControl x:Name="SeasonSelector"
                          ItemsSource="{Binding SelectedDetails.SeasonOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SeasonOptionViewModel">
                  <Button Classes="quiet season-chip"
                          Classes.active="{Binding IsSelected}"
                          Content="{Binding Label}"
                          AutomationProperties.Name="{Binding Label}"
                          Margin="0,0,8,8"
                          Command="{Binding SelectCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- A long manhwa can carry hundreds of chapters, so only the ones
               on screen are built. -->
          <ListBox x:Name="DetailsEntriesList"
                   ItemsSource="{Binding SelectedDetails.Entries}"
                   MaxHeight="{Binding #DetailsScroll.Bounds.Height}"
                   AutoScrollToSelectedItem="False">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CatalogContentEntryViewModel">
                <StackPanel>
                  <!-- Drawn by the row that opens a season rather than as an
                       item of its own, so the list stays one type and keeps
                       virtualizing, and the header can never take focus away
                       from an episode on a television. -->
                  <Border Classes="season-header"
                          IsVisible="{Binding ShowsSeasonHeader}">
                    <TextBlock Text="{Binding SeasonHeader}"
                               Classes="subtitle"
                               TextWrapping="Wrap" />
                  </Border>
                  <Border Classes="surface entry-card"
                          Padding="20"
                          Margin="0,0,0,14">
                    <!-- Dynamic sections participate directly in the card's
                         vertical layout, outside the centered artwork/header. -->
                    <StackPanel>
                      <Grid ColumnDefinitions="Auto,*">
                        <Border
                                IsVisible="{Binding HasArtwork}"
                                Margin="0,0,16,0">
                          <views:CatalogArtworkView Width="84"
                                                    Height="84"
                                                    DataContext="{Binding Artwork}" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Spacing="7"
                                    VerticalAlignment="Center">
                          <TextBlock Classes="subtitle"
                                     Text="{Binding Heading}"
                                     TextWrapping="Wrap" />
                          <TextBlock Classes="hint"
                                     Text="{Binding Subheading}" />
                          <TextBlock Classes="micro"
                                     Text="{DynamicResource NoMappedSource}"
                                     IsVisible="{Binding !HasAnySources}" />
                          <!-- Opening or finding the chapter leads, because that is
                               what the viewer came to the entry for. Marking it
                               seen is bookkeeping and sits at the end, one press to
                               the right rather than in the way. -->
                          <WrapPanel Classes="entry-actions"
                                     IsEnabled="{Binding !IsDeleting}"
                                     Orientation="Horizontal">
                            <Button Classes="quiet"
                                    Content="{Binding ApiImageActionText}"
                                    AutomationProperties.AutomationId="{Binding Identity.StableKey, StringFormat='entry-images-{0}'}"
                                    Command="{Binding OpenApiImagesCommand}"
                                    IsVisible="{Binding HasApiImages}"
                                    Margin="0,4,8,0" />
                            <Button Classes="quiet"
                                    Content="{Binding FindApiImagesActionText}"
                                    AutomationProperties.AutomationId="{Binding Identity.StableKey, StringFormat='entry-find-images-{0}'}"
                                    Command="{Binding FindApiImagesCommand}"
                                    IsVisible="{Binding CanFindApiImages}"
                                    Margin="0,4,8,0" />
                            <Button Classes="quiet"
                                    Content="{Binding ApiVideoActionText}"
                                    AutomationProperties.AutomationId="{Binding Identity.StableKey, StringFormat='entry-videos-{0}'}"
                                    Command="{Binding OpenApiVideosCommand}"
                                    IsVisible="{Binding HasApiVideos}"
                                    Margin="0,4,8,0" />
                            <Button Classes="quiet"
                                    Content="{Binding FindApiVideosActionText}"
                                    AutomationProperties.AutomationId="{Binding Identity.StableKey, StringFormat='entry-find-videos-{0}'}"
                                    Command="{Binding FindApiVideosCommand}"
                                    IsVisible="{Binding CanFindApiVideos}"
                                    Margin="0,4,8,0" />
                            <Button Classes="quiet"
                                    Command="{Binding ToggleSeenCommand}"
                                    AutomationProperties.AutomationId="{Binding Identity.StableKey, StringFormat='entry-seen-{0}'}"
                                    IsVisible="{Binding CanToggleSeen}"
                                    Margin="0,4,8,0">
                              <StackPanel Orientation="Horizontal"
                                          Spacing="7">
                                <TextBlock Text="{Binding SeenGlyph}"
                                           Foreground="{StaticResource MintBrush}" />
                                <TextBlock Text="{Binding SeenActionText}" />
                              </StackPanel>
                            </Button>
                            <Button Classes="danger"
                                    Content="{Binding DeleteActionText}"
                                    Command="{Binding RequestDeleteCommand}"
                                    IsVisible="{Binding CanDelete}"
                                    IsEnabled="{Binding !IsDeleting}"
                                    AutomationProperties.Name="{Binding DeleteActionText}"
                                    AutomationProperties.AutomationId="{Binding Identity.StableKey, StringFormat='entry-delete-{0}'}"
                                    Margin="0,4,8,0" />
                          </WrapPanel>
                        </StackPanel>
                      </Grid>
                      <Border Classes="notice danger"
                              Margin="0,10,0,0"
                              IsVisible="{Binding IsDeleteConfirmationVisible}">
                        <StackPanel Spacing="10">
                          <TextBlock Text="{Binding DeleteConfirmationText}" TextWrapping="Wrap" />
                          <WrapPanel Orientation="Horizontal" IsEnabled="{Binding !IsDeleting}">
                            <Button Classes="danger"
                                    Content="{Binding DeleteActionText}"
                                    Command="{Binding ConfirmDeleteCommand}"
                                    Margin="0,0,8,0" />
                            <Button Classes="quiet"
                                    Content="{DynamicResource Cancel}"
                                    Command="{Binding CancelDeleteCommand}" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>

                      <!-- Source picker for this entry, in place. -->
                      <ContentControl Content="{Binding Feedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />

                      <Border Classes="inner-card provider-choice-picker"
                              Margin="0,10,0,0"
                              IsVisible="{Binding IsProviderPickerVisible}">
                        <StackPanel Spacing="10">
                          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <ProgressBar Width="64"
                                         Grid.ColumnSpan="2"
                                         HorizontalAlignment="Left"
                                         AutomationProperties.Name="{DynamicResource BusyLabel}"
                                         IsIndeterminate="True"
                                         IsVisible="{Binding IsProviderSearchRunning}"
                                         VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1"
                                       Classes="hint"
                                       Text="{Binding ProviderChoiceMessage}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="1"
                                    Classes="quiet"
                                    Margin="10,0,0,0"
                                    Content="{DynamicResource Cancel}"
                                    Command="{Binding CancelProviderChoiceCommand}" />
                          </Grid>
                          <ItemsControl ItemsSource="{Binding ProviderChoices}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate
                                  x:DataType="vm:ApiContentProviderOptionViewModel">
                                <Button Classes="quiet provider-choice"
                                        Command="{Binding SelectCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left">
                                  <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding ProviderName}"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Classes="micro"
                                               Text="{Binding MatchText}" TextWrapping="Wrap" />
                                  </StackPanel>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                      <ItemsControl Margin="0,16,0,0"
                                    IsEnabled="{Binding !IsDeleting}"
                                    ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:CatalogMediaSourceViewModel">
                            <Border Background="{StaticResource SurfaceSunkenBrush}"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Padding="14,10">
                              <Grid ColumnDefinitions="*,Auto">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                  <TextBlock Text="{Binding Summary}"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             FontSize="{StaticResource FontSizeCaption}"
                                             TextAlignment="Left" />
                                  <TextBlock Classes="micro"
                                             Text="{Binding SourceKind}"
                                             TextAlignment="Left"
                                             TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="primary"
                                        Margin="12,0,0,0"
                                        Content="{Binding ActionText}"
                                        Command="{Binding OpenCommand}"
                                        IsEnabled="{Binding CanOpen}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </ScrollViewer>

      <Grid x:Name="EmbeddedPlayerSurface"
            Grid.Row="0"
            RowDefinitions="Auto,*,Auto,Auto,Auto"
            Background="{StaticResource ReaderCanvasBrush}"
            ClipToBounds="True"
            IsVisible="{Binding IsEmbeddedMediaOpen}">
        <Border x:Name="EmbeddedPlayerToolbar" Classes="reader-toolbar">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
            <Button Classes="quiet"
                    Command="{Binding CloseMediaPlayerCommand}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{DynamicResource BackToDetails}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="←"
                           FontSize="15"
                           VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource BackToDetails}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Margin="16,0">
              <TextBlock Text="{Binding ActiveMediaTitle}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         FontWeight="SemiBold"
                         FontSize="16"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="hint"
                         Text="{DynamicResource StreamingSource}" />
              <TextBlock Classes="hint"
                         Foreground="{StaticResource MintBrush}"
                         IsVisible="{Binding ShowWatchPartyPlayerStatus}"
                         Text="{Binding WatchPartyPlayerStatus}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ProgressBar Grid.Column="2"
                         Width="90"
                         AutomationProperties.Name="{DynamicResource BusyLabel}"
                         IsIndeterminate="{Binding IsBusy}"
                         IsVisible="{Binding IsBusy}" />
            <Button x:Name="PlayerPreviousEpisodeButton"
                    Grid.Column="3"
                    Classes="quiet"
                    Margin="12,0,0,0"
                    Content="{DynamicResource PreviousEpisode}"
                    Command="{Binding OpenPreviousEpisodeCommand}"
                    IsEnabled="{Binding CanOpenPreviousEpisode}"
                    IsVisible="{Binding HasPlayerEpisodeNavigation}"
                    AutomationProperties.Name="{DynamicResource PreviousEpisode}"
                    ToolTip.Tip="{DynamicResource PreviousEpisode}"
                    VerticalAlignment="Center" />
            <Button x:Name="PlayerNextEpisodeButton"
                    Grid.Column="4"
                    Classes="quiet"
                    Margin="8,0,0,0"
                    Content="{DynamicResource NextEpisode}"
                    Command="{Binding OpenNextEpisodeCommand}"
                    IsEnabled="{Binding CanOpenNextEpisode}"
                    IsVisible="{Binding HasPlayerEpisodeNavigation}"
                    AutomationProperties.Name="{DynamicResource NextEpisode}"
                    ToolTip.Tip="{DynamicResource NextEpisode}"
                    VerticalAlignment="Center" />
            <Button x:Name="PlayerFullscreenButton"
                    Grid.Column="5"
                    Classes="quiet"
                    Margin="12,0,0,0"
                    Content="{Binding PlayerFullscreenActionText}"
                    Command="{Binding TogglePlayerFullscreenCommand}"
                    AutomationProperties.Name="{Binding PlayerFullscreenActionText}"
                    ToolTip.Tip="{Binding PlayerFullscreenActionText}"
                    VerticalAlignment="Center" />
          </Grid>
        </Border>

        <ContentControl x:Name="EmbeddedPlayerContent"
                        Grid.Row="1"
                        Content="{Binding EmbeddedMediaView}"
                        Focusable="True"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        ClipToBounds="True" />

        <ContentControl Content="{Binding PlaybackFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" Grid.Row="2"/>

        <Border x:Name="EmbeddedPlayerServers"
                Grid.Row="3"
                Classes="reader-footer"
                IsVisible="{Binding HasActiveVideoServers}">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="14">
            <TextBlock Text="{DynamicResource VideoServers}"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontWeight="SemiBold" />
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ActiveVideoServers}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding DisplayLabel}"
                            Command="{Binding SelectCommand}"
                            IsEnabled="{Binding !IsSelected}"
                            MinWidth="92" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
        <ItemsControl Grid.Row="4" ItemsSource="{Binding ApiProviderChoices}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ApiContentProviderOptionViewModel">
              <Button Content="{Binding ProviderName}" Command="{Binding SelectCommand}"
                      Margin="8" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <Grid x:Name="ImageReaderSurface"
            Grid.Row="0"
            Background="{StaticResource ReaderCanvasBrush}"
            IsVisible="{Binding IsReaderOpen}"
            SizeChanged="ReaderViewport_OnSizeChanged">
        <ContentControl Content="{Binding ReaderFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" VerticalAlignment="Top" ZIndex="100" Margin="16,80,16,0"/>
        <Border x:Name="ReaderToolbar"
                ZIndex="40"
                Classes="reader-toolbar"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                IsVisible="False"
                PointerExited="ReaderToolbar_OnPointerExited">
          <StackPanel x:Name="ReaderToolbarContent">
            <Grid x:Name="ReaderHeaderGrid"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  RowDefinitions="Auto">
              <Button x:Name="ReaderBackButton"
                      Classes="quiet"
                      Command="{Binding CloseReaderCommand}"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{DynamicResource BackToDetails}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="←"
                             FontSize="15"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource BackToDetails}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <StackPanel Grid.Column="1"
                          Margin="14,0"
                          VerticalAlignment="Center">
                <TextBlock Text="{Binding Reader.Title}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontWeight="SemiBold"
                           FontSize="16"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="hint"
                           Text="{Binding Reader.PageStatus}" />
              </StackPanel>
              <Button x:Name="ReaderSettingsButton" Grid.Column="2" Classes="quiet"
                      Content="{DynamicResource ReaderSettingsTitle}"
                      VerticalAlignment="Center" Click="ReaderSettingsButton_OnClick"
                      AutomationProperties.Name="{DynamicResource ReaderSettingsTitle}" />
              <ProgressBar x:Name="ReaderBusyIndicator"
                           Grid.Column="3"
                           Margin="12,0,0,0"
                           Width="76"
                           AutomationProperties.Name="{DynamicResource BusyLabel}"
                           IsIndeterminate="{Binding IsBusy}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsBusy}" />
            </Grid>

          </StackPanel>
        </Border>

        <Border x:Name="ReaderSettingsPanel" Classes="surface reader-settings" ZIndex="45"
                IsVisible="False" Width="520" Padding="18" Margin="16,80,16,16"
                HorizontalAlignment="Right" VerticalAlignment="Top">
          <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="{DynamicResource ReaderSettingsTitle}" FontWeight="SemiBold"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button x:Name="ReaderSettingsCloseButton" Grid.Column="1" Classes="quiet"
                      Content="×" MinWidth="44" Padding="8" Click="ReaderSettingsCloseButton_OnClick"
                      AutomationProperties.Name="{DynamicResource ReaderSettingsClose}" />
            </Grid>
              <ScrollViewer x:Name="ReaderSettingsScroll" Grid.Row="1" MaxHeight="520" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ReaderSettingsContent" Spacing="14" Margin="4,8,4,12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{DynamicResource ReaderModeTitle}" FontWeight="SemiBold" />
                    <Border x:Name="ReaderModeControls"
                            Classes="segmented-control"
                            VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal"
                                  Spacing="2">
                        <Button Classes="reader-mode"
                                Classes.active="{Binding Reader.IsPaged}"
                                Content="{DynamicResource OnePage}"
                                Command="{Binding Reader.UsePagedModeCommand}" />
                        <Button Classes="reader-mode"
                                Classes.active="{Binding Reader.IsContinuous}"
                                Content="{DynamicResource Continuous}"
                                Command="{Binding Reader.UseContinuousModeCommand}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <StackPanel Spacing="6">
                    <TextBlock Text="{DynamicResource ReaderPageSizeTitle}" FontWeight="SemiBold" />
                    <Border x:Name="ReaderZoomControls"
                            Classes="segmented-control"
                            VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal"
                                  Spacing="2">
                        <Button Classes="reader-mode"
                                Content="-"
                                AutomationProperties.Name="{DynamicResource ZoomOut}"
                                ToolTip.Tip="{DynamicResource ZoomOut}"
                                Command="{Binding Reader.ZoomOutCommand}"
                                IsEnabled="{Binding Reader.CanZoomOut}" />
                        <Button Classes="reader-mode"
                                MinWidth="58"
                                Content="{Binding Reader.ZoomPercentage}"
                                AutomationProperties.Name="{DynamicResource ResetZoom}"
                                ToolTip.Tip="{DynamicResource ResetZoom}"
                                Command="{Binding Reader.ResetZoomCommand}" />
                        <Button Classes="reader-mode"
                                Content="+"
                                AutomationProperties.Name="{DynamicResource ZoomIn}"
                                ToolTip.Tip="{DynamicResource ZoomIn}"
                                Command="{Binding Reader.ZoomInCommand}"
                                IsEnabled="{Binding Reader.CanZoomIn}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <Border Height="1" Background="{StaticResource BorderSubtleBrush}" />
                  <views:ReaderAutoScrollControls x:Name="ReaderAutoScrollOptions"
                                                  DataContext="{Binding Reader}" IsVisible="{Binding IsContinuous}" />
                  <TextBlock Classes="hint" Text="{DynamicResource ReaderAutoScrollContinuousHint}"
                             IsVisible="{Binding Reader.IsPaged}" TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
          </Grid>
        </Border>

        <Grid>
          <Grid RowDefinitions="*,Auto"
                IsVisible="{Binding Reader.IsPaged}">
            <ScrollViewer x:Name="ReaderPagedScroll"
                          Padding="0,0,0,100"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Center">
              <views:ReaderPageView DataContext="{Binding Reader.CurrentPage}" />
            </ScrollViewer>
            <Border Grid.Row="1"
                    Classes="reader-footer">
              <Grid ColumnDefinitions="*,Auto,*">
                <Button Classes="quiet"
                        Content="{DynamicResource Previous}"
                        Command="{Binding Reader.PreviousPageCommand}"
                        IsEnabled="{Binding Reader.CanGoToPreviousPage}"
                        HorizontalAlignment="Right" />
                <TextBlock Grid.Column="1"
                           Margin="18,0"
                           Text="{Binding Reader.PageStatus}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Classes="quiet"
                        Content="{DynamicResource Next}"
                        Command="{Binding Reader.NextPageCommand}"
                        IsEnabled="{Binding Reader.CanGoToNextPage}"
                        HorizontalAlignment="Left" />
              </Grid>
            </Border>
          </Grid>

          <Grid IsVisible="{Binding Reader.IsContinuous}">
            <!-- AutoScrollToSelectedItem is off because in this list the
                 selection is the reading position, not a request to move. Left
                 on, the list drags the viewport back to whichever page is
                 selected: the reader saves progress and trims distant pages off
                 the current index, and any of that re-selecting mid-scroll
                 snapped the page being read back to one already passed — or
                 forward, when the selection sat below. Every scroll this reader
                 means is asked for by name (opening a chapter, restoring a
                 position, the go-to-top button). -->
            <ListBox x:Name="ReaderPages"
                     ItemsSource="{Binding Reader.Pages}"
                     SelectedItem="{Binding Reader.SelectedContinuousPage, Mode=TwoWay}"
                     Focusable="True"
                     AutoScrollToSelectedItem="False"
                     AutomationProperties.Name="{DynamicResource ReaderPagesLabel}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,0,0,100"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="VerticalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0" />
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="Background" Value="Transparent" />
                  <!-- Pages scroll past as a single surface. Focusing an
                       individual page lets virtualization recycle the focused
                       control away, which drops focus on the window root and
                       leaves the remote with nothing to move. -->
                  <Setter Property="Focusable" Value="False" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderThickness" Value="0" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <!-- Not virtualized, deliberately. A virtualizing panel does
                       not know the height of a page it has not realized, so it
                       estimates the extent from the average of the ones it has.
                       Manga pages vary enormously, so that average — and with it
                       the mapping from scroll offset to content — kept changing
                       as pages came and went, which is what moved the page out
                       from under the reader.

                       Every page having a container makes the extent exact and
                       the mapping fixed. Containers are cheap; the bitmaps are
                       not, and those stay loaded only around the reading
                       position, which ImageReaderViewModel now drives from the
                       visible page rather than from what happens to be
                       realized. A chapter long enough for the containers
                       themselves to cost something goes back to virtualizing,
                       which the code-behind switches by class. -->
                  <StackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ReaderPageViewModel">
                  <views:ReaderPageView />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Button x:Name="ScrollToTopButton"
                    ZIndex="20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,20,84"
                    Padding="0"
                    Background="{StaticResource AccentScrimBrush}"
                    BorderBrush="{StaticResource BorderAccentBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    FontSize="20"
                    Content="↑"
                    AutomationProperties.Name="{DynamicResource GoToTop}"
                    ToolTip.Tip="{DynamicResource GoToTop}"
                    IsVisible="False"
                    Click="ScrollToTop_OnClick" />
          </Grid>

        </Grid>

        <!-- One stack owns both floating bars. They used to be placed
             independently against the same edge, each with its own hand-set
             bottom margin, so the page options landed on top of the chapter
             navigation whenever both were up and every change to either bar's
             height had to be mirrored in the other's margin. Stacking them
             lets the layout keep them apart, and a bar that collapses closes
             its own gap. -->
        <StackPanel x:Name="ReaderBottomBars"
                    ZIndex="35"
                    Orientation="Vertical"
                    Spacing="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Margin="14,0,14,16">
          <Border x:Name="ReaderPageOptionsBar"
                  Classes="page-options"
                  Margin="0"
                  IsVisible="False">
            <StackPanel x:Name="ReaderTouchOptionsHost" />
          </Border>
          <Border x:Name="ReaderChapterNavigationBanner"
                  Classes="reader-chapter-nav"
                  HorizontalAlignment="Stretch"
                  Margin="0"
                  IsVisible="False">
            <Grid x:Name="ReaderDockButtons" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
              <Button x:Name="ReaderPreviousChapterButton" Grid.Column="0" Classes="reader-dock accent"
                      Command="{Binding OpenPreviousReaderChapterCommand}" IsEnabled="{Binding CanOpenPreviousReaderChapter}"
                      AutomationProperties.Name="{DynamicResource PreviousChapter}" ToolTip.Tip="{DynamicResource PreviousChapter}">
                <PathIcon Data="M4,3 H7 V21 H4 Z M20,3 V21 L8,12 Z" />
              </Button>
              <Button x:Name="ReaderAutoScrollButton" Grid.Column="1" Classes="reader-dock"
                      Command="{Binding Reader.ToggleAutoScrollCommand}" IsEnabled="{Binding Reader.IsContinuous}"
                      AutomationProperties.Name="{Binding Reader.AutoScrollActionLabel}" ToolTip.Tip="{Binding Reader.AutoScrollActionLabel}">
                <Grid>
                  <PathIcon Data="M6,3 L21,12 L6,21 Z" IsVisible="{Binding !Reader.IsAutoScrollEnabled}" />
                  <PathIcon Data="M5,3 H10 V21 H5 Z M14,3 H19 V21 H14 Z" IsVisible="{Binding Reader.IsAutoScrollEnabled}" />
                </Grid>
              </Button>
              <Button x:Name="ReaderFullscreenButton" Grid.Column="2" Classes="reader-dock" Click="ReaderFullscreenButton_OnClick"
                      AutomationProperties.Name="{DynamicResource PlayerEnterFullscreen}" ToolTip.Tip="{DynamicResource PlayerEnterFullscreen}">
                <PathIcon Data="M3,3 H10 V6 H6 V10 H3 Z M14,3 H21 V10 H18 V6 H14 Z M3,14 H6 V18 H10 V21 H3 Z M18,14 H21 V21 H14 V18 H18 Z" />
              </Button>
              <Button x:Name="ReaderChapterListButton" Grid.Column="3" Classes="reader-dock chapter accent"
                      Command="{Binding ReturnToMangaCommand}" AutomationProperties.Name="{DynamicResource BackToManga}"
                      ToolTip.Tip="{Binding Reader.Title}">
                <Grid x:Name="ReaderChapterLabelLayout" ColumnDefinitions="Auto,*">
                  <PathIcon Data="M2,4 H5 V7 H2 Z M8,4 H22 V7 H8 Z M2,10 H5 V13 H2 Z M8,10 H22 V13 H8 Z M2,16 H5 V19 H2 Z M8,16 H22 V19 H8 Z" />
                  <TextBlock Grid.Column="1" Text="{Binding ReaderChapterLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold" />
                </Grid>
              </Button>
              <Button x:Name="ReaderDockSettingsButton" Grid.Column="4" Classes="reader-dock" Click="ReaderSettingsButton_OnClick"
                      AutomationProperties.Name="{DynamicResource ReaderSettingsTitle}" ToolTip.Tip="{DynamicResource ReaderSettingsTitle}">
                <PathIcon Data="M2,5 H7 V3 H10 V5 H22 V7 H10 V9 H7 V7 H2 Z M2,11 H15 V9 H18 V11 H22 V13 H18 V15 H15 V13 H2 Z M2,17 H7 V15 H10 V17 H22 V19 H10 V21 H7 V19 H2 Z" />
              </Button>
              <Button x:Name="ReaderNextChapterButton" Grid.Column="5" Classes="reader-dock accent"
                      Command="{Binding OpenNextReaderChapterCommand}" IsEnabled="{Binding CanOpenNextReaderChapter}"
                      AutomationProperties.Name="{DynamicResource NextChapter}" ToolTip.Tip="{DynamicResource NextChapter}">
                <PathIcon Data="M17,3 H20 V21 H17 Z M4,3 L16,12 L4,21 Z" />
              </Button>
            </Grid>
          </Border>
        </StackPanel>

        <Border x:Name="ReaderTopHoverZone"
                ZIndex="39"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="Transparent"
                PointerEntered="ReaderTopHoverZone_OnPointerEntered"
                PointerPressed="ReaderTopHoverZone_OnPointerPressed" />
        <Canvas IsHitTestVisible="False" ZIndex="50">
          <Border x:Name="ReaderMiddleScrollAnchor" IsVisible="False"
                  Width="32" Height="32" CornerRadius="16"
                  Background="{StaticResource ReaderChipBrush}" BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="1">
            <TextBlock Text="↕" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Canvas>
      </Grid>

      <Grid Grid.Row="0"
            RowDefinitions="Auto,*,Auto"
            Background="{StaticResource ReaderCanvasBrush}"
            IsVisible="{Binding IsEpubReaderOpen}">
        <ContentControl Content="{Binding ReaderFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" Grid.Row="1" VerticalAlignment="Top" ZIndex="100" Margin="16"/>
        <Border Classes="reader-toolbar">
          <Grid x:Name="EpubHeaderGrid"
                ColumnDefinitions="Auto,*,Auto,Auto"
                RowDefinitions="Auto">
            <Button Classes="quiet"
                    Command="{Binding CloseReaderCommand}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{DynamicResource BackToDetails}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="←"
                           FontSize="15"
                           VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource BackToDetails}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel Grid.Column="1"
                        Margin="14,0"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding EpubReader.Title}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         FontWeight="SemiBold"
                         FontSize="16"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="hint"
                         Text="{Binding EpubReader.ChapterStatus}" />
            </StackPanel>
            <Border x:Name="EpubFontControls"
                    Grid.Column="2"
                    Classes="segmented-control"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"
                          Spacing="2">
                <Button Classes="reader-mode"
                        Content="A−"
                        AutomationProperties.Name="{DynamicResource DecreaseFont}"
                        Command="{Binding EpubReader.DecreaseFontSizeCommand}" />
                <Button Classes="reader-mode"
                        Content="A+"
                        AutomationProperties.Name="{DynamicResource IncreaseFont}"
                        Command="{Binding EpubReader.IncreaseFontSizeCommand}" />
              </StackPanel>
            </Border>
            <ProgressBar x:Name="EpubBusyIndicator"
                         Grid.Column="3"
                         Margin="12,0,0,0"
                         Width="76"
                         AutomationProperties.Name="{DynamicResource BusyLabel}"
                         IsIndeterminate="{Binding IsBusy}"
                         IsVisible="{Binding IsBusy}" />
          </Grid>
        </Border>

        <Border x:Name="EpubPageOptionsBar"
                Grid.Row="1"
                Classes="page-options"
                ZIndex="35"
                Margin="14,0,14,16"
                IsVisible="False">
          <StackPanel x:Name="EpubPageOptionsPanel"
                      Orientation="Horizontal"
                      Spacing="8" />
        </Border>

        <Border x:Name="EpubReadingSurface"
                Grid.Row="1"
                MaxWidth="860"
                Margin="24"
                Padding="52,40,52,28"
                HorizontalAlignment="Stretch"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusXl}">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Classes="display"
                       Text="{Binding EpubReader.CurrentChapter.Title}"
                       Margin="0,0,0,18"
                       TextWrapping="Wrap" />
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding EpubReader.CurrentChapter.Blocks}"
                     AutomationProperties.Name="{DynamicResource EpubContentLabel}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EpubContentBlockViewModel">
                  <views:EpubContentBlockView />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <Border Grid.Row="2"
                Classes="reader-footer">
          <Grid ColumnDefinitions="*,Auto,*">
            <Button Classes="quiet"
                    Content="{DynamicResource PreviousChapter}"
                    Command="{Binding EpubReader.PreviousChapterCommand}"
                    HorizontalAlignment="Right" />
            <TextBlock Grid.Column="1"
                       Margin="18,0"
                       Text="{Binding EpubReader.ChapterStatus}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Classes="quiet"
                    Content="{DynamicResource NextChapter}"
                    Command="{Binding EpubReader.NextChapterCommand}"
                    HorizontalAlignment="Left" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Settings sits over the page instead of replacing it, so the title or
         shelf the viewer was on is still underneath when they close it. -->
    <!-- RowSpan as well as ColumnSpan: the shell switches between one and two
         rows for the compact top bar, and without this the layer is pinned to
         row 0, where an Auto-sized top bar grows to the height of the whole
         settings stack and pushes the page off screen. -->
    <Grid x:Name="SettingsOverlay"
          Grid.ColumnSpan="2"
          Grid.RowSpan="2"
          ZIndex="290"
          IsVisible="{Binding ShowSettingsPanels}">
      <Border Background="#E60A0D14" />
      <Border x:Name="SettingsCard"
              Classes="surface"
              MaxWidth="1180">
        <Grid RowDefinitions="Auto,*">
          <Grid x:Name="SettingsHeader" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="title"
                       Text="{DynamicResource SettingsTitle}"
                       VerticalAlignment="Center" />
            <Button x:Name="SettingsCloseButton"
                    Grid.Column="1"
                    Classes="quiet"
                    Content="{DynamicResource SettingsClose}"
                    Command="{Binding CloseSettingsCommand}"
                    VerticalAlignment="Center" />
          </Grid>
          <ScrollViewer x:Name="SettingsScroll"
                        Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SettingsContent" Spacing="18">

          <!-- Switching is only offered here and at startup: changing who is
               using the application closes whatever was open, which is not
               something to put within reach of a mis-tap while reading. -->
          <Border Classes="surface settings-card"
                  IsVisible="{Binding SupportsProfiles}">
            <StackPanel Spacing="14">
              <TextBlock Classes="subtitle"
                         Text="{DynamicResource ProfilesTitle}" />
              <ContentControl Content="{Binding ProfilesFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />
              <TextBlock Classes="hint"
                         TextWrapping="Wrap"
                         Text="{DynamicResource ProfilesDescription}" />

              <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileTileViewModel">
                    <Border Classes="inner-card" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Classes="body"
                                     TextWrapping="Wrap"
                                     Text="{Binding Name}" />
                          <TextBlock Classes="hint"
                                     IsVisible="{Binding IsActive}"
                                     Text="{DynamicResource InUseLabel}" />
                        </StackPanel>
                        <WrapPanel Classes="friend-actions"
                                   VerticalAlignment="Center">
                          <Button Classes="primary"
                                  Margin="8,0"
                                  MinHeight="40"
                                  IsVisible="{Binding !IsActive}"
                                  Content="{DynamicResource SwitchProfile}"
                                  Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectProfileCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="quiet danger"
                                  MinHeight="40"
                                  Content="{DynamicResource RemoveProfile}"
                                  Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveProfileCommand}"
                                  CommandParameter="{Binding}" />
                        </WrapPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid Classes="settings-row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                <TextBox Text="{Binding NewProfileName}"
                         MaxLength="40"
                         MinHeight="44"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="{DynamicResource NewProfileName}"
                         PlaceholderText="{DynamicResource NewProfileName}" />
                <Button Classes="quiet settings-secondary"
                        MinHeight="44"
                        VerticalAlignment="Center"
                        Content="{DynamicResource AddProfile}"
                        Command="{Binding AddProfileCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="surface settings-card"
                  IsVisible="{Binding ShowSettingsPanels}">
            <StackPanel Spacing="14">
              <Grid Classes="settings-row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                    ColumnSpacing="16">
                <StackPanel Spacing="5">
                  <TextBlock Classes="subtitle"
                             Text="{DynamicResource DonationTitle}" />
                  <TextBlock Classes="hint"
                             Text="{DynamicResource DonationSettingsDescription}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <Border Classes="chip mint settings-secondary"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                  <TextBlock Text="{DynamicResource DonationStablecoins}"
                             Foreground="{StaticResource MintTextBrush}"
                             FontWeight="Bold" />
                </Border>
              </Grid>
              <Image Source="/Assets/donation-qr.png"
                     Width="190"
                     Height="190"
                     Stretch="Uniform"
                     HorizontalAlignment="Center"
                     AutomationProperties.Name="{DynamicResource DonationQrCode}" />
              <StackPanel Spacing="6">
                <TextBlock Classes="field-label"
                           Text="{DynamicResource DonationAddressLabel}" />
                <Border Classes="inner-card"
                        Padding="12"
                        AutomationProperties.Name="{DynamicResource DonationAddressLabel}">
                  <TextBlock Text="{Binding DonationAddress}"
                             TextWrapping="Wrap"
                             FontFamily="Consolas, Menlo, monospace" />
                </Border>
              </StackPanel>
              <TextBlock Classes="micro"
                         Text="{DynamicResource DonationNetworkWarning}"
                         TextWrapping="Wrap" />
              <WrapPanel Orientation="Horizontal">
                <Button Classes="primary"
                        Content="{DynamicResource DonationOpen}"
                        Command="{Binding ShowDonationPromptCommand}"
                        Margin="0,0,8,8" />
                <Button Classes="quiet"
                        Content="{DynamicResource DonationCopyAddress}"
                        Click="CopyDonationAddress_OnClick" />
                <TextBlock Text="{DynamicResource DonationAddressCopied}"
                           IsVisible="{Binding IsDonationAddressCopied}"
                           Foreground="{StaticResource MintTextBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Classes="surface settings-card"
                  IsVisible="{Binding ShowApplicationUpdateSettings}">
            <Grid Classes="settings-row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                  ColumnSpacing="18">
              <StackPanel Spacing="6">
                <TextBlock Classes="subtitle"
                           Text="{DynamicResource ApplicationUpdatesTitle}"
                           TextWrapping="Wrap" />
              <ContentControl Content="{Binding UpdatesFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />
                <TextBlock Classes="hint"
                           Text="{DynamicResource ApplicationUpdatesDescription}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding AvailableUpdateTitle}"
                           IsVisible="{Binding HasAvailableUpdate}"
                           Foreground="{StaticResource AccentTextBrush}"
                           FontWeight="SemiBold" />
              </StackPanel>
              <Button Classes="settings-secondary"
                      Content="{DynamicResource CheckForUpdates}"
                      Command="{Binding CheckForUpdatesCommand}"
                      IsEnabled="{Binding !IsCheckingForUpdates}"
                      VerticalAlignment="Bottom" />
            </Grid>
          </Border>

          <Border Classes="surface settings-card"
                  IsVisible="{Binding ShowRemoteSyncSettings}">
            <StackPanel Spacing="16">
              <StackPanel Spacing="5">
                <TextBlock Classes="subtitle"
                           Text="{DynamicResource RemoteServerTitle}" />
              <ContentControl Content="{Binding AccountFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />
                <TextBlock Classes="hint"
                           Text="{DynamicResource RemoteServerDescription}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <Border Classes="inner-card"
                      Padding="14">
                <StackPanel Spacing="12">
                  <TextBlock Text="{Binding RemoteAccountSummary}"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             FontSize="{StaticResource FontSizeBody}"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap" />

                  <StackPanel Spacing="6">
                    <TextBlock Classes="field-label"
                               Text="{DynamicResource RemoteServerUrl}" />
                    <TextBox Text="{Binding RemoteServiceUrl}"
                             IsEnabled="{Binding !IsRemoteSignedIn}"
                             AutomationProperties.Name="{DynamicResource RemoteServerUrl}"
                             PlaceholderText="{DynamicResource RemoteServerUrlPlaceholder}" />
                  </StackPanel>

                  <UniformGrid Classes="settings-account-fields">
                    <StackPanel Classes="settings-account-field" Spacing="6">
                      <TextBlock Classes="field-label"
                                 Text="{DynamicResource RemoteUsername}" />
                      <TextBox Text="{Binding RemoteUsername}"
                               IsEnabled="{Binding !IsRemoteSignedIn}"
                               AutomationProperties.Name="{DynamicResource RemoteUsername}" />
                    </StackPanel>
                    <StackPanel Classes="settings-account-field" Spacing="6">
                      <TextBlock Classes="field-label"
                                 Text="{DynamicResource RemotePassword}" />
                      <TextBox Text="{Binding RemotePassword}"
                               IsEnabled="{Binding !IsRemoteSignedIn}"
                               PasswordChar="*"
                               AutomationProperties.Name="{DynamicResource RemotePassword}" />
                    </StackPanel>
                    <StackPanel Classes="settings-account-field" Spacing="6">
                      <TextBlock Classes="field-label"
                                 Text="{DynamicResource RemoteDisplayName}" />
                      <TextBox Text="{Binding RemoteDisplayName}"
                               IsEnabled="{Binding !IsRemoteSignedIn}"
                               AutomationProperties.Name="{DynamicResource RemoteDisplayName}" />
                    </StackPanel>
                    <StackPanel Classes="settings-account-field" Spacing="6">
                      <TextBlock Classes="field-label"
                                 Text="{DynamicResource RemoteDeviceName}" />
                      <TextBox Text="{Binding RemoteDeviceName}"
                             AutomationProperties.Name="{DynamicResource RemoteDeviceName}" />
                    </StackPanel>
                  </UniformGrid>

                  <StackPanel Spacing="3">
                    <CheckBox Content="{DynamicResource RemoteOnlineCatalog}"
                              IsChecked="{Binding RemoteOnlineCatalogEnabled}" />
                    <TextBlock Classes="micro"
                               Text="{DynamicResource RemoteOnlineCatalogDescription}"
                               TextWrapping="Wrap"
                               Margin="26,0,0,0" />
                  </StackPanel>

                  <WrapPanel Orientation="Horizontal">
                    <Button Classes="primary"
                            Content="{DynamicResource RemoteSaveSettings}"
                            Command="{Binding SaveRemoteServerSettingsCommand}"
                            IsEnabled="{Binding !IsRemoteSyncBusy}"
                            Margin="0,0,8,8" />
                    <Button Content="{DynamicResource RemoteCreateAccount}"
                            Command="{Binding RegisterRemoteAccountCommand}"
                            IsVisible="{Binding !IsRemoteSignedIn}"
                            IsEnabled="{Binding !IsRemoteSyncBusy}"
                            Margin="0,0,8,8" />
                    <Button Classes="primary"
                            Content="{DynamicResource RemoteSignIn}"
                            Command="{Binding SignInRemoteAccountCommand}"
                            IsVisible="{Binding !IsRemoteSignedIn}"
                            IsEnabled="{Binding !IsRemoteSyncBusy}"
                            Margin="0,0,8,8" />
                    <Button Classes="quiet"
                            Content="{DynamicResource RemoteSignOut}"
                            Command="{Binding SignOutRemoteAccountCommand}"
                            IsVisible="{Binding IsRemoteSignedIn}"
                            IsEnabled="{Binding !IsRemoteSyncBusy}"
                            Margin="0,0,8,8" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Classes="inner-card"
                      Padding="14"
                      IsVisible="{Binding IsRemoteSignedIn}">
                <StackPanel Spacing="10">
                  <TextBlock Text="{DynamicResource RemoteSnapshotTitle}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             FontSize="{StaticResource FontSizeBodyLarge}"
                             FontWeight="SemiBold" />
                  <TextBlock Classes="hint"
                             Text="{Binding RemoteSnapshotSummary}"
                             TextWrapping="Wrap" />
                  <WrapPanel Orientation="Horizontal">
                    <Button Classes="quiet"
                            Content="{DynamicResource RemoteRefresh}"
                            Command="{Binding RefreshRemoteSnapshotCommand}"
                            IsEnabled="{Binding CanUseRemoteSync}"
                            Margin="0,0,8,8" />
                    <Button Content="{DynamicResource RemoteUpload}"
                            Command="{Binding UploadRemoteSnapshotCommand}"
                            IsEnabled="{Binding CanUseRemoteSync}"
                            Margin="0,0,8,8" />
                    <Button Classes="quiet"
                            Content="{DynamicResource RemoteRestore}"
                            Command="{Binding RequestRestoreRemoteSnapshotCommand}"
                            IsEnabled="{Binding CanRestoreRemoteSnapshot}"
                            Margin="0,0,8,8" />
                  </WrapPanel>

                  <Border Classes="notice positive"
                          Padding="12"
                          IsVisible="{Binding IsRemoteRestoreConfirmationVisible}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="{DynamicResource RemoteRestoreWarning}"
                                 Foreground="{StaticResource MintTextBrush}"
                                 TextWrapping="Wrap" />
                      <WrapPanel Orientation="Horizontal">
                        <Button
                                Content="{DynamicResource RemoteRestoreNow}"
                                Command="{Binding ConfirmRestoreRemoteSnapshotCommand}"
                                IsEnabled="{Binding CanUseRemoteSync}"
                                Margin="0,0,8,0" />
                        <Button Classes="quiet"
                                Content="{DynamicResource Cancel}"
                                Command="{Binding CancelRestoreRemoteSnapshotCommand}"
                                IsEnabled="{Binding !IsRemoteSyncBusy}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <TextBlock Classes="micro"
                         Text="{DynamicResource RemoteSyncPrivacy}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="surface settings-card"
                  IsVisible="{Binding ShowSettingsPanels}">
            <StackPanel Spacing="14">
              <StackPanel>
                <TextBlock Classes="subtitle"
                           Text="{DynamicResource ContentSourcesTitle}" />
              <ContentControl Content="{Binding SourcesFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />
                <TextBlock Classes="hint"
                           Text="{DynamicResource ContentSourcesDescription}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
              </StackPanel>

              <!-- Grouped by kind, because sixteen online sources listed flat
                   made switching a whole category on a sixteen-tap job and
                   made it hard to see what was even on. -->
              <ItemsControl ItemsSource="{Binding ContentSourceProviderGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ContentSourceProviderGroupViewModel">
                    <StackPanel Spacing="10"
                                Margin="0,0,0,18">
                      <Grid Classes="settings-row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                            ColumnSpacing="10">
                        <Button Classes="quiet"
                                Command="{Binding ToggleExpandedCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                AutomationProperties.Name="{Binding Title}">
                          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                            <TextBlock Grid.RowSpan="2" Text="{Binding ExpandGlyph}"
                                       Foreground="{StaticResource AccentTextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Grid.Row="1" Classes="hint" TextWrapping="Wrap"
                                       Text="{Binding SummaryText}"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                        <Button Classes="quiet settings-secondary"
                                Content="{Binding ToggleAllText}"
                                Command="{Binding ToggleAllCommand}"
                                IsVisible="{Binding CanToggleAll}"
                                VerticalAlignment="Center" />
                      </Grid>

                      <StackPanel IsVisible="{Binding IsExpanded}">
                        <ItemsControl ItemsSource="{Binding Providers}"
                                      ItemTemplate="{StaticResource ContentSourceProviderRowTemplate}"
                                      IsVisible="{Binding ShowsDirectProviders}" />

                        <!-- API sources are easier to scan by the media they
                             serve than as one long provider list. -->
                        <ItemsControl ItemsSource="{Binding ApiCategories}"
                                      IsVisible="{Binding HasApiCategories}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ApiContentProviderCategoryViewModel">
                              <StackPanel Margin="16,0,0,14"
                                          Spacing="9">
                                <Grid Classes="settings-row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                                      ColumnSpacing="10">
                                  <Button Classes="quiet"
                                          Command="{Binding ToggleExpandedCommand}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Left"
                                          AutomationProperties.Name="{Binding Title}">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                                      <TextBlock Grid.RowSpan="2" Text="{Binding ExpandGlyph}"
                                                 Foreground="{StaticResource MintTextBrush}"
                                                 VerticalAlignment="Center" />
                                      <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap"
                                                 FontWeight="SemiBold"
                                                 VerticalAlignment="Center" />
                                      <TextBlock Grid.Column="1" Grid.Row="1" Classes="hint" TextWrapping="Wrap"
                                                 Text="{Binding SummaryText}"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                  </Button>
                                  <Button Classes="quiet settings-secondary"
                                          Content="{Binding ToggleAllText}"
                                          Command="{Binding ToggleAllCommand}"
                                          IsVisible="{Binding CanToggleAll}"
                                          VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Providers}"
                                              ItemTemplate="{StaticResource ContentSourceProviderRowTemplate}"
                                              IsVisible="{Binding IsExpanded}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Classes="inner-card">
                <StackPanel Spacing="12">
                  <TextBlock Classes="field-label"
                             Text="{DynamicResource AddTorrentProvider}" />
                  <TextBox Text="{Binding NewTorrentProviderName}"
                           AutomationProperties.Name="{DynamicResource ContentSourceNameLabel}"
                           PlaceholderText="{DynamicResource TorrentProviderNamePlaceholder}" />
                  <TextBox Text="{Binding NewTorrentProviderBaseUrl}"
                           AutomationProperties.Name="{DynamicResource ContentSourceBaseUrlLabel}"
                           PlaceholderText="{DynamicResource TorrentProviderUrlPlaceholder}" />
                  <Button Classes="quiet"
                          Content="{DynamicResource AddTorrentProvider}"
                          Command="{Binding AddTorrentProviderCommand}"
                          IsEnabled="{Binding !IsBusy}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <StackPanel Spacing="12">
                <TextBlock Classes="micro"
                           Text="{DynamicResource ApiProviderCodeOnlyHint}"
                           TextWrapping="Wrap" />
                <Button Classes="primary"
                        Content="{DynamicResource SaveContentSources}"
                        Command="{Binding SaveContentSourcesCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        HorizontalAlignment="Left" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="surface settings-card"
                  IsVisible="{Binding ShowSettingsPanels}">
            <StackPanel Spacing="14">
              <StackPanel>
                <TextBlock Classes="subtitle"
                           Text="{DynamicResource MetadataProviders}" />
              <ContentControl Content="{Binding MetadataFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />
                <TextBlock Classes="hint"
                           Text="{Binding MetadataProviderAvailabilityText}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
              </StackPanel>

              <Grid x:Name="MetadataSettingsGrid"
                    ColumnDefinitions="*,*,150,Auto"
                    ColumnSpacing="8">
                <StackPanel x:Name="TmdbSettings"
                            Classes="metadata-field">
                  <TextBlock Classes="field-label"
                             Text="{DynamicResource TmdbApiKey}" />
                   <TextBox Text="{Binding TmdbApiKey}"
                            AutomationProperties.Name="{DynamicResource TmdbApiKeyLabel}"
                            PasswordChar="●"
                            PlaceholderText="{DynamicResource TmdbApiKeyPlaceholder}" />
                </StackPanel>
                <StackPanel x:Name="MalSettings"
                            Classes="metadata-field"
                            Grid.Column="1"
                            IsVisible="{Binding SupportsMyAnimeListMetadata}">
                  <TextBlock Classes="field-label"
                             Text="{DynamicResource MalClientId}" />
                   <TextBox Text="{Binding MyAnimeListClientId}"
                            AutomationProperties.Name="{DynamicResource MalClientIdLabel}"
                            PasswordChar="●"
                            PlaceholderText="{DynamicResource MalClientIdPlaceholder}" />
                </StackPanel>
                <StackPanel x:Name="MalUnavailable"
                            Classes="metadata-field"
                            Grid.Column="1"
                            IsVisible="{Binding !SupportsMyAnimeListMetadata}">
                  <TextBlock Classes="micro"
                             Text="MyAnimeList" />
                  <TextBlock Text="{DynamicResource NativeOnly}"
                             Foreground="{StaticResource AmberBrush}"
                             FontSize="{StaticResource FontSizeCaption}"
                             Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel x:Name="LanguageSettings"
                            Classes="metadata-field"
                            Grid.Column="2">
                  <TextBlock Classes="field-label"
                             Text="{DynamicResource PreferredLanguage}" />
                   <TextBox Text="{Binding MetadataLanguage}"
                            AutomationProperties.Name="{DynamicResource MetadataLanguageLabel}"
                            PlaceholderText="{DynamicResource PreferredLanguagePlaceholder}" />
                </StackPanel>
                <Button x:Name="SaveMetadataButton"
                        Grid.Column="3"
                        Classes="primary"
                        Content="{DynamicResource SaveProviderSettings}"
                        Command="{Binding SaveMetadataOptionsCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        VerticalAlignment="Bottom" />
              </Grid>

              <TextBlock Classes="micro"
                         Text="{DynamicResource CredentialDisclosure}"
                         TextWrapping="Wrap" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Path Width="105"
                      Height="16"
                      Stretch="Uniform"
                      Data="M191.85,35.37h63.9A17.67,17.67,0,0,0,273.42,17.7h0A17.67,17.67,0,0,0,255.75,0h-63.9A17.67,17.67,0,0,0,174.18,17.7h0A17.67,17.67,0,0,0,191.85,35.37ZM10.1,35.42h7.8V6.92H28V0H0v6.9H10.1Zm28.1,0H46V8.25h.1L55.05,35.4h6L70.3,8.25h.1V35.4h7.8V0H66.45l-8.2,23.1h-.1L50,0H38.2ZM89.14.12h11.7a33.56,33.56,0,0,1,8.08,1,18.52,18.52,0,0,1,6.67,3.08,15.09,15.09,0,0,1,4.53,5.52,18.5,18.5,0,0,1,1.67,8.25,16.91,16.91,0,0,1-1.62,7.58,16.3,16.3,0,0,1-4.38,5.5,19.24,19.24,0,0,1-6.35,3.37,24.53,24.53,0,0,1-7.55,1.15H89.14Zm7.8,28.2h4a21.66,21.66,0,0,0,5-.55A10.58,10.58,0,0,0,110,26a8.73,8.73,0,0,0,2.68-3.35,11.9,11.9,0,0,0,1-5.08,9.87,9.87,0,0,0-1-4.52,9.17,9.17,0,0,0-2.63-3.18A11.61,11.61,0,0,0,106.22,8a17.06,17.06,0,0,0-4.68-.63h-4.6ZM133.09.12h13.2a32.87,32.87,0,0,1,4.63.33,12.66,12.66,0,0,1,4.17,1.3,7.94,7.94,0,0,1,3,2.72,8.34,8.34,0,0,1,1.15,4.65,7.48,7.48,0,0,1-1.67,5,9.13,9.13,0,0,1-4.43,2.82V17a10.28,10.28,0,0,1,3.18,1,8.51,8.51,0,0,1,2.45,1.85,7.79,7.79,0,0,1,1.57,2.62,9.16,9.16,0,0,1,.55,3.2,8.52,8.52,0,0,1-1.2,4.68,9.32,9.32,0,0,1-3.1,3A13.38,13.38,0,0,1,152.32,35a22.5,22.5,0,0,1-4.73.5h-14.5Zm7.8,14.15h5.65a7.65,7.65,0,0,0,1.78-.2,4.78,4.78,0,0,0,1.57-.65,3.43,3.43,0,0,0,1.13-1.2,3.63,3.63,0,0,0,.42-1.8A3.3,3.3,0,0,0,151,8.6a3.42,3.42,0,0,0-1.23-1.13A6.07,6.07,0,0,0,148,6.9a9.9,9.9,0,0,0-1.85-.18h-5.3Zm0,14.65h7a8.27,8.27,0,0,0,1.83-.2,4.67,4.67,0,0,0,1.67-.7,3.93,3.93,0,0,0,1.23-1.3,3.8,3.8,0,0,0,.47-1.95,3.16,3.16,0,0,0-.62-2,4,4,0,0,0-1.58-1.18,8.23,8.23,0,0,0-2-.55,15.12,15.12,0,0,0-2.05-.15h-5.9Z">
                  <Path.Fill>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                      <GradientStop Color="#90CEA1" Offset="0" />
                      <GradientStop Color="#3CBEC9" Offset="0.56" />
                      <GradientStop Color="#00B3E5" Offset="1" />
                    </LinearGradientBrush>
                  </Path.Fill>
                </Path>
                <TextBlock Grid.Column="1" Text="{DynamicResource MetadataAttribution}"
                           Foreground="{StaticResource AccentTextBrush}"
                           FontSize="{StaticResource FontSizeMicro}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="surface settings-card"
                  IsVisible="{Binding ShowSettingsPanels}">
            <StackPanel Spacing="14">
              <Grid Classes="settings-row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel>
                  <TextBlock Classes="subtitle"
                             Text="{DynamicResource OpenMagnetTitle}" />
              <ContentControl Content="{Binding MagnetFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />
                  <TextBlock Classes="hint"
                             Text="{Binding MagnetEngineStatus}"
                             Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Classes="settings-secondary"
                           Text="{DynamicResource PublicByDefault}"
                           Foreground="{StaticResource MintBrush}"
                           FontSize="{StaticResource FontSizeMicro}"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
              </Grid>

              <Grid Classes="settings-row" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding MagnetLinkInput}"
                         AutomationProperties.Name="{DynamicResource MagnetInputLabel}"
                         PlaceholderText="magnet:?xt=urn:btih:..." />
                <Button Classes="settings-secondary"
                        Content="{DynamicResource OpenMagnet}"
                        Command="{Binding OpenMagnetCommand}"
                        IsEnabled="{Binding !IsBusy}" />
                <Button Classes="settings-tertiary"
                        Content="{DynamicResource OpenTorrentFile}"
                        AutomationProperties.Name="{DynamicResource OpenTorrentFile}"
                        Click="OpenTorrentFile_OnClick"
                        IsVisible="{Binding ShowOperationalPanels}"
                        IsEnabled="{Binding !IsBusy}" />
              </Grid>

              <WrapPanel Orientation="Horizontal">
                <CheckBox Content="{DynamicResource OpenMagnetsAutomatically}"
                          IsChecked="{Binding OpenMagnetsAutomatically}"
                          Margin="0,0,18,0" />
                <CheckBox Content="{DynamicResource ImportInfoJson}"
                          IsChecked="{Binding ImportTorrentInfoJson}"
                          Margin="0,0,18,0" />
                <CheckBox Content="{DynamicResource ForcePrivate}"
                          IsChecked="{Binding TreatExternalMagnetsAsPrivate}"
                          Margin="0,0,18,0" />
                <Button Classes="primary"
                        Content="{DynamicResource SaveOptions}"
                        Command="{Binding SaveMagnetOptionsCommand}"
                        IsEnabled="{Binding !IsBusy}" />
              </WrapPanel>

              <Border Classes="notice warning"
                      Padding="10"
                      IsVisible="{Binding HasPendingMagnet}">
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource PendingMagnet}"
                               Foreground="{StaticResource AmberTextBrush}"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSizeCaption}" />
                    <TextBlock Text="{Binding PendingMagnetDisplay}"
                               Foreground="{StaticResource AmberTextBrush}"
                               FontSize="{StaticResource FontSizeMicro}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Classes="settings-secondary"
                          Content="{DynamicResource OpenReceivedMagnet}"
                          Command="{Binding OpenPendingMagnetCommand}"
                          IsEnabled="{Binding !IsBusy}" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="surface settings-card"
                  IsVisible="{Binding ShowSettingsPanels}">
            <StackPanel Spacing="10">
              <TextBlock Classes="subtitle"
                         Text="{DynamicResource ContentFilterTitle}" />
              <ContentControl Content="{Binding FiltersFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />
              <TextBlock Classes="hint"
                         Text="{DynamicResource ContentFilterDescription}"
                         TextWrapping="Wrap" />
              <StackPanel Spacing="3">
                <CheckBox Content="{DynamicResource HideAdultContent}"
                          IsChecked="{Binding HideAdultContent}" />
                <TextBlock Classes="micro"
                           Text="{DynamicResource HideAdultContentDescription}"
                           TextWrapping="Wrap"
                           Margin="26,0,0,0" />
              </StackPanel>
              <Grid Classes="settings-row" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="12"
                    Margin="0,4,0,0">
                <StackPanel Spacing="5">
                  <TextBlock Classes="hint"
                             Text="{DynamicResource ContentFilterModeLabel}" />
                  <ComboBox ItemsSource="{Binding ContentFilterModes}"
                            SelectedItem="{Binding SelectedContentFilterMode}"
                            DisplayMemberBinding="{Binding DisplayName}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{DynamicResource ContentFilterModeLabel}" />
                </StackPanel>
                <Button Classes="primary settings-secondary"
                        Content="{DynamicResource SaveContentFilterOptions}"
                        Command="{Binding SaveContentFilterOptionsCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        VerticalAlignment="Bottom" />
                <Button Classes="settings-tertiary"
                        Content="{DynamicResource UpdateFilterLists}"
                        Command="{Binding UpdateFilterListsCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        IsVisible="{Binding CanUpdateFilterLists}"
                        VerticalAlignment="Bottom" />
              </Grid>
              <TextBlock Classes="hint"
                         Text="{Binding SelectedContentFilterModeDescription}"
                         TextWrapping="Wrap" />
              <TextBlock Text="{DynamicResource ContentFilterModeCapped}"
                         Foreground="{StaticResource AmberTextBrush}"
                         FontSize="{StaticResource FontSizeMicro}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding IsContentFilterModeCapped}" />
              <TextBlock Classes="hint"
                         Text="{Binding ContentFilterStatus}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding ContentFilterStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="hint"
                         Text="{Binding ContentFilterPlaybackStatus}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding ContentFilterPlaybackStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{DynamicResource ContentFilterListSources}"
                         FontSize="{StaticResource FontSizeMicro}"
                         Opacity="0.75"
                         TextWrapping="Wrap"
                         IsVisible="{Binding CanUpdateFilterLists}" />
            </StackPanel>
          </Border>

          <Border Classes="surface settings-card"
                  IsVisible="{Binding ShowSettingsPanels}">
            <Grid Classes="settings-row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                  ColumnSpacing="18">
              <StackPanel Spacing="7">
                <TextBlock Classes="subtitle"
                           Text="{DynamicResource DownloadCleanupTitle}" />
              <ContentControl Content="{Binding DownloadOptionsFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />
                <TextBlock Classes="hint"
                           Text="{DynamicResource DownloadCleanupDescription}"
                           TextWrapping="Wrap" />
                <CheckBox
                    Content="{DynamicResource DeleteDownloadsAtSessionEnd}"
                    IsChecked="{Binding DeleteTorrentDataWhenSessionEnds}"
                    Margin="0,5,0,0" />
                <TextBlock Text="{DynamicResource DownloadCleanupWarning}"
                           Foreground="{StaticResource AmberTextBrush}"
                           FontSize="{StaticResource FontSizeMicro}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding DeleteTorrentDataWhenSessionEnds}" />
              </StackPanel>
              <Button Classes="primary settings-secondary"
                      Content="{DynamicResource SaveDownloadOptions}"
                      Command="{Binding SaveDownloadOptionsCommand}"
                      IsEnabled="{Binding !IsBusy}"
                      VerticalAlignment="Bottom" />
            </Grid>
          </Border>

          <Border Classes="surface settings-card"
                  IsVisible="{Binding ShowSettingsFileActions}">
            <Grid x:Name="CatalogDataGrid"
                  ColumnDefinitions="*,Auto,Auto">
              <StackPanel x:Name="CatalogDataDescription">
                <TextBlock Classes="subtitle"
                           Text="{DynamicResource CatalogData}" />
              <ContentControl Content="{Binding FilesFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />
                <TextBlock Classes="hint"
                           Text="{DynamicResource CatalogDataDescription}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
              </StackPanel>
              <Button x:Name="ImportCatalogButton"
                      Grid.Column="1"
                      Content="{DynamicResource ImportCatalog}"
                      Click="ImportCatalogJson_OnClick"
                      IsEnabled="{Binding !IsBusy}" />
              <Button x:Name="ExportCatalogButton"
                      Grid.Column="2"
                      Content="{DynamicResource ExportCatalog}"
                      Click="ExportCatalogJson_OnClick"
                      IsEnabled="{Binding !IsBusy}" />
            </Grid>
          </Border>

          <Border Classes="surface settings-card"
                  IsVisible="{Binding ShowSettingsBackup}">
            <Grid x:Name="BackupGrid"
                  ColumnDefinitions="*,Auto,Auto">
              <StackPanel x:Name="BackupDescription">
                <ContentControl Content="{Binding BackupFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />
                <TextBlock Classes="subtitle"
                           Text="{DynamicResource FullBackup}" />
                <TextBlock Classes="hint"
                           Text="{DynamicResource FullBackupDescription}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
              </StackPanel>
              <Button x:Name="CreateBackupButton"
                      Grid.Column="1"
                      Content="{DynamicResource CreateBackup}"
                      Click="ExportFullDatabase_OnClick"
                      IsEnabled="{Binding !IsBusy}" />
              <Button x:Name="RestoreBackupButton"
                      Grid.Column="2"
                      Content="{DynamicResource RestoreBackup}"
                      Click="RestoreFullDatabase_OnClick"
                      IsEnabled="{Binding !IsBusy}" />
            </Grid>
          </Border>

            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <!-- A lightweight call for support appears at launch and can be reopened
         from Settings. It never blocks startup work and can always be dismissed. -->
    <Border x:Name="DonationPrompt"
            Grid.ColumnSpan="2"
            Grid.RowSpan="2"
            ZIndex="330"
            Background="{StaticResource ScrimBrush}"
            IsVisible="{Binding IsDonationPromptVisible}">
      <Border x:Name="DonationCard"
              Classes="surface"
              Margin="24"
              Padding="30"
              MaxWidth="720"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              BoxShadow="{StaticResource ShadowFloating}">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="14">
            <StackPanel Spacing="6">
              <TextBlock Classes="title"
                         Text="{DynamicResource DonationTitle}"
                         TextWrapping="Wrap" />
              <Border Classes="chip mint"
                      HorizontalAlignment="Left">
                <TextBlock Text="{DynamicResource DonationStablecoins}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MintTextBrush}"
                           FontWeight="Bold" />
              </Border>
            </StackPanel>
            <Button x:Name="DonationCloseButton"
                    Grid.Column="1"
                    Classes="quiet"
                    Width="40"
                    Height="40"
                    MinHeight="40"
                    Padding="0"
                    CornerRadius="999"
                    Content="×"
                    AutomationProperties.Name="{DynamicResource DonationDismiss}"
                    ToolTip.Tip="{DynamicResource DonationDismiss}"
                    Command="{Binding DismissDonationPromptCommand}" />
          </Grid>
          <ScrollViewer x:Name="DonationBodyScroll"
                        Grid.Row="1"
                        Focusable="True"
                        Padding="0,0,12,0"
                        AutomationProperties.Name="{DynamicResource DonationTitle}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
          <TextBlock Classes="body"
                     Text="{DynamicResource DonationStartupMessage}"
                     TextWrapping="Wrap" />
          <Image x:Name="DonationQrImage"
                 Source="/Assets/donation-qr.png"
                 Width="260"
                 Height="260"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 AutomationProperties.Name="{DynamicResource DonationQrCode}" />
          <StackPanel Spacing="7">
            <TextBlock Classes="field-label"
                       Text="{DynamicResource DonationAddressLabel}" />
            <Border Classes="inner-card"
                    Padding="12"
                    AutomationProperties.Name="{DynamicResource DonationAddressLabel}">
              <TextBlock Text="{Binding DonationAddress}"
                         TextWrapping="Wrap"
                         FontFamily="Consolas, Menlo, monospace" />
            </Border>
          </StackPanel>
          <Border Classes="notice"
                  Padding="12">
            <TextBlock Classes="micro"
                       Text="{DynamicResource DonationNetworkWarning}"
                       TextWrapping="Wrap" />
          </Border>
          </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="{DynamicResource DonationAddressCopied}"
                       IsVisible="{Binding IsDonationAddressCopied}"
                       Foreground="{StaticResource MintTextBrush}"
                       TextWrapping="Wrap" />
          <Grid x:Name="DonationActions"
                ColumnDefinitions="*,*"
                ColumnSpacing="10" RowSpacing="8">
            <Button x:Name="DonationDismissButton"
                    Grid.Column="0"
                    Classes="primary"
                    IsDefault="True"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource DonationDismiss}"
                    Command="{Binding DismissDonationPromptCommand}" />
            <Button x:Name="DonationCopyButton"
                    Grid.Column="1"
                    Classes="quiet"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource DonationCopyAddress}"
                    Click="CopyDonationAddress_OnClick" />
          </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Border>
    <!-- The party moved on to another title and this member is not on it
         yet. Floating top-centre, away from the update prompt on the right
         and the torrent card at the bottom. -->
    <Border x:Name="WatchPartyFollowPromptCard"
            Grid.ColumnSpan="2"
            ZIndex="305"
            MaxWidth="560"
            Margin="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{StaticResource OverlayAccentBrush}"
            BorderBrush="{StaticResource BorderAccentBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusXl}"
            Padding="18"
            BoxShadow="{StaticResource ShadowFloating}"
            IsVisible="{Binding ShowWatchPartyFollowPrompt}">
      <Grid ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="12">
        <StackPanel Spacing="3"
                    VerticalAlignment="Center">
          <TextBlock Classes="subtitle"
                     Text="{DynamicResource WatchPartyTitle}" />
              <ContentControl Content="{Binding PartyFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />
          <TextBlock Classes="hint"
                     Text="{Binding WatchPartyFollowPromptText}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="primary"
                MinHeight="40"
                VerticalAlignment="Center"
                Content="{DynamicResource WatchPartyOpenContentAction}"
                Command="{Binding OpenWatchPartyContentCommand}" />
        <Button Grid.Column="2"
                Classes="quiet"
                MinHeight="40"
                VerticalAlignment="Center"
                Content="{DynamicResource WatchPartyFollowDismiss}"
                Command="{Binding DismissWatchPartyFollowPromptCommand}" />
      </Grid>
    </Border>
    <Border x:Name="UpdatePrompt"
            Grid.ColumnSpan="2"
            ZIndex="310"
            MaxWidth="520"
            Margin="20"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{StaticResource OverlayAccentBrush}"
            BorderBrush="{StaticResource BorderAccentBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusXl}"
            Padding="20"
            BoxShadow="{StaticResource ShadowFloating}"
            IsVisible="{Binding IsUpdatePromptVisible}">
      <StackPanel Spacing="13">
          <ContentControl Content="{Binding UpdatesFeedback}"
                          ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />
        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12">
          <Border Width="38"
                  Height="38"
                  CornerRadius="999"
                  Background="{StaticResource AccentSoftBrush}"
                  VerticalAlignment="Top">
            <TextBlock Text="⇧"
                       Foreground="{StaticResource AccentTextBrush}"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Classes="subtitle"
                       Text="{Binding AvailableUpdateTitle}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding AvailableUpdateSize}"
                       Foreground="{StaticResource MintBrush}"
                       FontSize="{StaticResource FontSizeCaption}"
                       FontWeight="SemiBold" />
          </StackPanel>
          <Button x:Name="DismissUpdatePromptTopButton"
                  Grid.Column="2"
                  Classes="quiet"
                  Width="36"
                  Height="36"
                  MinHeight="36"
                  Padding="0"
                  CornerRadius="999"
                  Content="×"
                  VerticalAlignment="Top"
                  AutomationProperties.Name="{DynamicResource UpdateLater}"
                  ToolTip.Tip="{DynamicResource UpdateLater}"
                  Command="{Binding DismissUpdatePromptCommand}"
                  IsEnabled="{Binding !IsDownloadingUpdate}" />
        </Grid>

        <TextBlock Classes="hint"
                   Text="{Binding AvailableUpdateNotes}"
                   MaxLines="4"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="micro"
                   Text="{DynamicResource UpdateAskFirstNotice}"
                   TextWrapping="Wrap" />

        <ProgressBar Height="8"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding UpdateDownloadProgressPercent}"
                     IsVisible="{Binding IsDownloadingUpdate}" />

        <WrapPanel Orientation="Horizontal"
                   HorizontalAlignment="Right">
          <Button x:Name="DismissUpdatePromptButton"
                  Classes="quiet"
                  Content="{DynamicResource UpdateLater}"
                  Command="{Binding DismissUpdatePromptCommand}"
                  IsEnabled="{Binding !IsDownloadingUpdate}"
                  Margin="0,0,8,0" />
          <Button x:Name="InstallAvailableUpdateButton"
                  Classes="primary"
                  Content="{Binding UpdateActionText}"
                  Command="{Binding InstallAvailableUpdateCommand}"
                  IsEnabled="{Binding !IsDownloadingUpdate}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Grid.ColumnSpan="2"
            ZIndex="300"
            Classes="torrent-activity"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsVisible="{Binding HasActiveTorrentActivity}">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto"
            ColumnDefinitions="*,Auto">
        <StackPanel Spacing="3">
          <ContentControl Content="{Binding DownloadsFeedback}"
                          ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />
          <TextBlock Text="{Binding ActiveTorrentActivity.Title}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     FontSize="15"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="hint"
                     Text="{Binding TorrentActivityDetailText}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Button Grid.Column="1"
                Classes="quiet"
                Width="36"
                Height="36"
                MinHeight="36"
                Padding="0"
                CornerRadius="999"
                Content="×"
                VerticalAlignment="Top"
                AutomationProperties.Name="{DynamicResource DismissTorrentActivity}"
                ToolTip.Tip="{DynamicResource DismissTorrentActivity}"
                Command="{Binding DismissActiveTorrentCommand}" />

        <Grid Grid.Row="1"
              Grid.ColumnSpan="2"
              Margin="0,12,0,0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <TextBlock Text="{Binding TorrentActivityPhaseText}"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     FontWeight="SemiBold" />
          <TextBlock Grid.Column="1"
                     Text="{Binding TorrentActivityProgressText}"
                     Foreground="{StaticResource AccentTextBrush}"
                     FontWeight="SemiBold" />
        </Grid>

        <ProgressBar Grid.Row="2"
                     Grid.ColumnSpan="2"
                     Margin="0,8,0,0"
                     Height="7"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding TorrentProgressPercent}"
                     IsIndeterminate="{Binding IsTorrentProgressIndeterminate}"
                     AutomationProperties.Name="{Binding TorrentActivityProgressText}" />

        <Grid Grid.Row="3"
              Grid.ColumnSpan="2"
              Margin="0,10,0,0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <TextBlock Classes="hint"
                     Text="{Binding TorrentActivityMetricsText}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="7">
            <Button Classes="activity-action"
                    Content="{DynamicResource PauseTorrent}"
                    Command="{Binding PauseActiveTorrentCommand}"
                    IsVisible="{Binding CanPauseActiveTorrent}" />
            <Button Classes="activity-action"
                    Content="{DynamicResource ResumeTorrent}"
                    Command="{Binding ResumeActiveTorrentCommand}"
                    IsVisible="{Binding CanResumeActiveTorrent}" />
            <Button Classes="activity-action"
                    Content="{DynamicResource StopTorrent}"
                    Command="{Binding CancelActiveTorrentCommand}"
                    IsVisible="{Binding CanCancelActiveTorrent}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- Who is using the device. Over everything, because until it is answered
         nothing on the page belongs to anybody in particular. Only ever shown
         when there is more than one profile to choose between. -->
    <Border x:Name="ProfilePickerScrim"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            ZIndex="150"
            Background="{StaticResource ScrimBrush}"
            IsVisible="{Binding IsProfilePickerOpen}">
      <Border Classes="surface"
              Padding="34"
              MaxWidth="720"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="20">
          <TextBlock Classes="title"
                     HorizontalAlignment="Center"
                     Text="{DynamicResource ProfilesTitle}" />
              <ContentControl Content="{Binding ProfilesFeedback}" ContentTemplate="{StaticResource ErrorFeedbackTemplate}" />
          <TextBlock Classes="hint"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     Text="{DynamicResource ProfilesDescription}" />

          <ItemsControl ItemsSource="{Binding Profiles}"
                        HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"
                           HorizontalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileTileViewModel">
                <Button Classes="profile-tile"
                        Margin="10"
                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectProfileCommand}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Name}">
                  <StackPanel Spacing="10">
                    <Border Classes="profile-avatar">
                      <TextBlock Text="{Binding Initial}"
                                 FontSize="38"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Name}"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="130" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Border>

    <!-- Always in the same place, across everything. Declared last and given
         the highest ZIndex so it survives the sidebar, the drawer scrim and the
         reader's own overlays: a bar that a page can cover is a bar nobody can
         rely on. It sits above the layout rather than in a row of it, so
         appearing costs no reflow and cannot shift what is being read. -->
    <Border Classes="notice positive" Grid.ColumnSpan="2" ZIndex="210"
            IsVisible="{Binding HasStatus}" IsHitTestVisible="False"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            MaxWidth="360" Margin="20" Padding="14,10">
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                 AutomationProperties.Name="{DynamicResource StatusMessageLabel}"
                 Foreground="{StaticResource MintTextBrush}" />
    </Border>

    <ProgressBar x:Name="GlobalBusyBar"
                 Grid.Column="0"
                 Grid.ColumnSpan="2"
                 ZIndex="200"
                 Classes="global-busy"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Stretch"
                 IsHitTestVisible="False"
                 AutomationProperties.Name="{DynamicResource BusyLabel}"
                 IsIndeterminate="{Binding IsAnythingLoading}"
                 IsVisible="{Binding IsAnythingLoading}" />
  </Grid>
</UserControl>
