<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces: a soft, low-contrast stack instead of near-black panels. -->
  <SolidColorBrush x:Key="BackdropBrush" Color="#131722" />
  <SolidColorBrush x:Key="SidebarBrush" Color="#181D29" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#1B212D" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#212836" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#232A39" />
  <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#151A24" />
  <SolidColorBrush x:Key="ReaderCanvasBrush" Color="#101319" />

  <!-- Borders: visible enough to group content, quiet enough to disappear. -->
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#272E3D" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#343D4F" />
  <SolidColorBrush x:Key="BorderAccentBrush" Color="#6F8CE8" />
  <SolidColorBrush x:Key="DividerBrush" Color="#242B3A" />

  <!-- Text ramp. -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F5FA" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C6CDDC" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#98A1B5" />
  <SolidColorBrush x:Key="TextFaintBrush" Color="#7A8397" />

  <!-- Primary accent (periwinkle) plus its tinted fills. -->
  <SolidColorBrush x:Key="AccentBrush" Color="#7C9CFF" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#A9C2FF" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#26304A" />
  <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#2E3A58" />
  <SolidColorBrush x:Key="AccentSoftPressedBrush" Color="#202940" />
  <SolidColorBrush x:Key="AccentChipBrush" Color="#28324C" />

  <!-- Positive / media-kind accents. -->
  <SolidColorBrush x:Key="MintBrush" Color="#63D9B4" />
  <SolidColorBrush x:Key="MintTextBrush" Color="#93E8CE" />
  <SolidColorBrush x:Key="MintSoftBrush" Color="#17322C" />
  <SolidColorBrush x:Key="MintBorderBrush" Color="#2F6E5E" />
  <SolidColorBrush x:Key="AmberBrush" Color="#FFC46B" />
  <SolidColorBrush x:Key="AmberTextBrush" Color="#F0D49B" />
  <SolidColorBrush x:Key="AmberSoftBrush" Color="#2E2718" />
  <SolidColorBrush x:Key="AmberBorderBrush" Color="#6E5F31" />
  <SolidColorBrush x:Key="OrchidBrush" Color="#C9A6FF" />
  <SolidColorBrush x:Key="OrchidSoftBrush" Color="#282039" />

  <!-- Warnings read as concerned, not alarming. -->
  <SolidColorBrush x:Key="DangerBrush" Color="#FF9FAC" />
  <SolidColorBrush x:Key="DangerTextBrush" Color="#FFC7CF" />
  <SolidColorBrush x:Key="DangerMutedTextBrush" Color="#D9A2AC" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#331F27" />
  <SolidColorBrush x:Key="DangerBorderBrush" Color="#6E3B48" />

  <!-- Translucent layers for toolbars, toasts and floating panels. -->
  <SolidColorBrush x:Key="ScrimBrush" Color="#F0181E2A" />
  <SolidColorBrush x:Key="OverlayBrush" Color="#F51D2432" />
  <SolidColorBrush x:Key="OverlayAccentBrush" Color="#F51F2A40" />
  <SolidColorBrush x:Key="BadgeScrimBrush" Color="#D9222B3E" />
  <SolidColorBrush x:Key="MintScrimBrush" Color="#D31C3B32" />
  <SolidColorBrush x:Key="AccentScrimBrush" Color="#F22F3D60" />
  <SolidColorBrush x:Key="ReaderChipBrush" Color="#BF161B25" />
  <!-- Phone chrome that floats over content: the page stays visible through it. -->
  <SolidColorBrush x:Key="PageOptionsBrush" Color="#B21B212D" />
  <SolidColorBrush x:Key="DrawerScrimBrush" Color="#99070910" />

  <!-- Corner radii: rounder everywhere so panels feel approachable. -->
  <CornerRadius x:Key="RadiusSm">10</CornerRadius>
  <CornerRadius x:Key="RadiusMd">14</CornerRadius>
  <CornerRadius x:Key="RadiusLg">18</CornerRadius>
  <CornerRadius x:Key="RadiusXl">22</CornerRadius>

  <!-- Type scale. -->
  <x:Double x:Key="FontSizeMicro">10</x:Double>
  <x:Double x:Key="FontSizeCaption">11.5</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeBodyLarge">14.5</x:Double>
  <x:Double x:Key="FontSizeSubtitle">17</x:Double>
  <x:Double x:Key="FontSizeTitle">21</x:Double>
  <x:Double x:Key="FontSizeDisplay">30</x:Double>

  <!-- Elevation. -->
  <BoxShadows x:Key="ShadowSoft">0 8 24 0 #5C000000</BoxShadows>
  <BoxShadows x:Key="ShadowFloating">0 16 40 0 #73000000</BoxShadows>

  <!-- Navigation icons. Vector geometry instead of Unicode glyphs: symbol
       glyphs come from whichever fallback font has them, so their sizes and
       baselines never match, and they blur when a television scales them up. -->
  <StreamGeometry x:Key="IconHome">M12 3 3 10.6V21h6.2v-5.8h5.6V21H21V10.6Z</StreamGeometry>
  <StreamGeometry x:Key="IconMovies">M8.4 5.2 19 12 8.4 18.8Z</StreamGeometry>
  <StreamGeometry x:Key="IconAnime">M12 3.6l2.6 5.5 6 .8-4.4 4.2 1.1 6-5.3-2.9-5.3 2.9 1.1-6L3.4 9.9l6-.8Z</StreamGeometry>
  <StreamGeometry x:Key="IconBooks">M12 6.4C10.4 5 8.3 4.3 6 4.3c-1.1 0-2.1.1-3.1.4v14.4c1-.3 2-.4 3.1-.4 2.3 0 4.4.7 6 2 1.6-1.3 3.7-2 6-2 1.1 0 2.1.1 3.1.4V4.7c-1-.3-2-.4-3.1-.4-2.3 0-4.4.7-6 2.1Z</StreamGeometry>
  <StreamGeometry x:Key="IconLiveTv">M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-5v2h-6v-2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm0 2v10h16V7Zm6 2.2 5 2.8-5 2.8Z</StreamGeometry>
  <StreamGeometry x:Key="IconMenu">M3.5 6h17v2.2h-17Zm0 4.9h17v2.2h-17Zm0 4.9h17v2.2h-17Z</StreamGeometry>
  <StreamGeometry x:Key="IconLists">M4 5.8h16v2.1H4Zm0 5.2h16v2.1H4Zm0 5.2h11v2.1H4Z</StreamGeometry>
  <StreamGeometry x:Key="IconFriends">M9.4 12.1a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm0 1.7c-2.9 0-5.8 1.5-5.8 3.3V19.6h11.6v-2.5c0-1.8-2.9-3.3-5.8-3.3Zm7.3-2.2a2.8 2.8 0 1 0 0-5.6 2.8 2.8 0 0 0 0 5.6Zm.5 1.9c-.7 0-1.3.1-1.9.3 1.3.9 2.1 2 2.1 3.3v2.5h4.1v-2.4c0-1.7-2.2-2.8-4.3-2.8Z</StreamGeometry>
  <StreamGeometry x:Key="IconDownloads">M11 3h2v7.4l2.7-2.7 1.5 1.5L12 14.4 6.8 9.2l1.5-1.5L11 10.4Zm-6 14h14v2.1H5Z</StreamGeometry>
  <StreamGeometry x:Key="IconSettings">M12 8.6a3.4 3.4 0 1 0 0 6.8 3.4 3.4 0 0 0 0-6.8Zm8.8 3.4c0-.5 0-1-.1-1.5l2-1.4-1.9-3.3-2.3.9c-.8-.7-1.7-1.2-2.7-1.5L15.4 3H8.6l-.4 2.2c-1 .3-1.9.8-2.7 1.5l-2.3-.9L1.3 9.1l2 1.4a9.4 9.4 0 0 0 0 3l-2 1.4 1.9 3.3 2.3-.9c.8.7 1.7 1.2 2.7 1.5l.4 2.2h6.8l.4-2.2c1-.3 1.9-.8 2.7-1.5l2.3.9 1.9-3.3-2-1.4c.1-.5.1-1 .1-1.5Z</StreamGeometry>
  <StreamGeometry x:Key="IconImport">M20 14.6v4.2a2.1 2.1 0 0 1-2.1 2.1H6.1A2.1 2.1 0 0 1 4 18.8v-4.2h2.1v4.2h11.8v-4.2ZM13 3v7.4l2.7-2.7 1.5 1.5L12 14.4 6.8 9.2l1.5-1.5L11 10.4V3Z</StreamGeometry>
  <StreamGeometry x:Key="IconExport">M20 14.6v4.2a2.1 2.1 0 0 1-2.1 2.1H6.1A2.1 2.1 0 0 1 4 18.8v-4.2h2.1v4.2h11.8v-4.2ZM11 16.4V9L8.3 11.7 6.8 10.2 12 5l5.2 5.2-1.5 1.5L13 9v7.4Z</StreamGeometry>
</ResourceDictionary>
