<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- net11.0 so every head compiles against the same runtime the Android
         one needs for its NativeAOT packs. Publishing stays self-contained
         NativeAOT, so the deployment host needs no .NET runtime installed. -->
    <TargetFramework>net11.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Admin\index.html" />
    <EmbeddedResource Include="Admin\app.js" />
    <EmbeddedResource Include="Admin\style.css" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <ProjectReference
      Include="..\UniversalMediaDistribution.Catalog\UniversalMediaDistribution.Catalog.csproj" />
    <ProjectReference
      Include="..\UniversalMediaDistribution.Domain\UniversalMediaDistribution.Domain.csproj" />
  </ItemGroup>
</Project>
