<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- The heads target net11.0 and publish self-contained, and NativeAOT for
         android-arm needs ILCompiler plus its runtime packs at build time.
         Until .NET 11 ships, those only exist as preview builds on the public
         dnceng feed. Remove this source, and the mapping below, once they are
         on nuget.org. -->
    <add key="dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" />
  </packageSources>
  <!-- Central package management warns (NU1507) when more than one source is
       configured without a mapping.
       The SDK pulls a long tail of implementation packages by exact version -
       runtime packs, ILCompiler, Crossgen2, ILLink, apphosts - and which of
       them a build needs depends on the head, the RID and whether it is AOT.
       Enumerating them one at a time just moves the NU1102 to the next pack,
       so the whole Microsoft and runtime prefixes are served by both feeds and
       NuGet resolves each exact version from whichever has it. Everything
       else, meaning third-party packages, stays pinned to nuget.org. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.*" />
      <package pattern="runtime.*" />
    </packageSource>
    <packageSource key="dotnet11">
      <package pattern="Microsoft.*" />
      <package pattern="runtime.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
