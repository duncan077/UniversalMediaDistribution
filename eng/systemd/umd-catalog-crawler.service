[Unit]
Description=UMD catalog metadata backfill and refresh

[Service]
Type=oneshot
# Match the existing umd-server deployment and its durable data directory.
Environment=UMD_SERVER_DATA_DIRECTORY=%h/apps/umd-server/data
EnvironmentFile=%h/apps/umd-server/config/environment
WorkingDirectory=%h/apps/umd-server
ExecStart=%h/apps/umd-server/current/UniversalMediaDistribution.Server --scrape-once
TimeoutStartSec=55min
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
